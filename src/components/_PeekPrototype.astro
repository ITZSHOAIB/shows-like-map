---
// PROTOTYPE (#3 hold-to-peek): hold a match's poster to see more before hopping. Round 2: the details won (over the
// fan); two places to show them, switched with ?peek=pop|panel or the bar at the bottom. Throwaway: remove when one
// is picked. Round 1 (bottom sheet and fan) is in commit history.
export interface PeekLead { slug: string; name: string; poster: string | null }
export interface PeekShow { name: string; poster: string | null; facts: string[]; why: string; summary: string | null; leads: PeekLead[] }
interface Props { data: Record<string, PeekShow>; from: string }
const { data, from } = Astro.props;
---

<script type="application/json" id="pk-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
<dialog class="pk-pop" id="pk-pop" aria-labelledby="pk-pop-title" data-from={from}></dialog>
<section class="pk-panel" id="pk-panel" aria-labelledby="pk-panel-title" hidden></section>

<div class="pk-bar">
  <b>PROTOTYPE</b> Hold a poster:
  <a href="?peek=pop" data-mode="pop">Pop-out</a>
  <a href="?peek=panel" data-mode="panel">Inline</a>
</div>

<script>
  type Lead = { slug: string; name: string; poster: string | null };
  type Peek = { name: string; poster: string | null; facts: string[]; why: string; summary: string | null; leads: Lead[] };
  const data: Record<string, Peek> = JSON.parse(document.getElementById("pk-data")!.textContent!);

  const asked = new URLSearchParams(location.search).get("peek");
  if (asked) try { sessionStorage.setItem("slm:peek", asked); } catch {}
  let mode = "pop";
  try { mode = sessionStorage.getItem("slm:peek") === "panel" ? "panel" : "pop"; } catch {}
  document.querySelectorAll<HTMLElement>(".pk-bar a").forEach((a) => a.classList.toggle("on", a.dataset.mode === mode));

  const pop = document.getElementById("pk-pop") as HTMLDialogElement;
  const panel = document.getElementById("pk-panel")!;
  const from = pop.dataset.from!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";
  const slugOf = (a: Element) => a.getAttribute("href")!.split("/")[2];
  const posterOf = (card: Element) => card.querySelector(".poster, .poster-ph")!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };
  const posterEl = (src: string | null, name: string, cls = "") => {
    if (!src) return el("span", `poster-ph ${cls}`, name);
    const img = el("img", `poster ${cls}`);
    img.src = src; img.alt = ""; img.draggable = false;
    return img;
  };

  // Jumping two levels: the show in between goes on "Your path" too, so the strip still tells the way you came.
  const via = (slug: string) => {
    try {
      const path = JSON.parse(sessionStorage.getItem("slm:path") || "[]");
      if (path.at(-1)?.slug !== slug) path.push({ slug, name: data[slug].name, poster: data[slug].poster });
      sessionStorage.setItem("slm:path", JSON.stringify(path.slice(-12)));
    } catch {}
  };

  // The details, the same in both places.
  function details(card: HTMLAnchorElement, titleId: string, withPoster: boolean, close: () => void) {
    const s = data[slugOf(card)];
    const head = el("div", "pk-head");
    if (withPoster) head.append(posterEl(s.poster, s.name, "pk-poster"));
    const text = el("div");
    const title = el("h2", "", s.name);
    title.id = titleId;
    const facts = el("ul", "pk-facts");
    facts.append(...s.facts.map((f) => el("li", "pill", f)));
    text.append(el("p", "eyebrow", `Like ${from}`), title, facts);
    head.append(text);
    const body: HTMLElement[] = [head, el("p", "pk-why", s.why)];
    if (s.summary) body.push(el("p", "pk-sum", s.summary));
    if (s.leads.length) {
      const leads = el("ol", "pk-leads");
      leads.append(...s.leads.slice(0, 4).map((l) => {
        const a = el("a", "pk-lead");
        a.href = `/shows/${l.slug}/`;
        a.append(posterEl(l.poster, l.name), el("span", "", l.name));
        a.addEventListener("click", () => via(slugOf(card)));
        const li = el("li");
        li.append(a);
        return li;
      }));
      body.push(el("p", "eyebrow pk-leads-label", "Leads to"), leads);
    }
    const actions = el("div", "pk-actions");
    const openBtn = el("a", "pk-open", "Open");
    openBtn.href = card.href;
    openBtn.addEventListener("click", (e) => {
      // Through the card itself, so the poster morphs into the next hero as with a tap.
      e.preventDefault();
      close();
      card.click();
    });
    const closeBtn = el("button", "pk-close", "Close");
    closeBtn.type = "button";
    closeBtn.addEventListener("click", close);
    actions.append(openBtn, closeBtn);
    body.push(actions);
    return body;
  }

  // ---------- the hold ----------
  let press: { card: HTMLAnchorElement; x: number; y: number; timer: number } | null = null;
  let held: HTMLAnchorElement | null = null;
  let holding = false; // the finger that opened the peek is still down
  let releasedAt = 0;
  // The finger that opened the peek is still on the screen, or only just lifted: whatever is under it now (a link in
  // the peek) must not get its long-press menu or a tap.
  const fresh = () => holding || performance.now() - releasedAt < 400;

  const endPress = () => {
    if (press) { clearTimeout(press.timer); press.card.classList.remove("pk-pressing"); }
    press = null;
  };
  const open = (card: HTMLAnchorElement) => {
    endPress();
    holding = true;
    navigator.vibrate?.(10);
    if (mode === "panel") openPanel(card); else openPop(card);
  };

  document.querySelector(".rows")?.addEventListener("pointerdown", (e) => {
    const p = e as PointerEvent;
    const card = (p.target as Element).closest<HTMLAnchorElement>("a.card");
    if (!card || p.button > 0 || !data[slugOf(card)]) return;
    card.classList.add("pk-pressing");
    press = { card, x: p.clientX, y: p.clientY, timer: window.setTimeout(() => open(card), 420) };
  });
  addEventListener("pointermove", (e) => {
    if (press && Math.hypot(e.clientX - press.x, e.clientY - press.y) > 10) endPress();
  });
  const release = () => {
    endPress();
    if (holding) { holding = false; releasedAt = performance.now(); }
  };
  addEventListener("pointerup", release);
  addEventListener("pointercancel", release);
  document.addEventListener("touchmove", (e) => { if (holding) e.preventDefault(); }, { passive: false });
  document.addEventListener("contextmenu", (e) => {
    const t = e.target as Element;
    if (fresh() || t.closest?.(".track a.card, .pk-pop, .pk-panel")) e.preventDefault();
    // A long press that beat our timer, or a right-click on a desktop: peek.
    const card = t.closest?.<HTMLAnchorElement>(".track a.card");
    if (card && data[slugOf(card)] && !holding) open(card);
  });
  // The tap the opening finger makes as it lifts goes nowhere.
  document.addEventListener("click", (e) => {
    if (!fresh()) return;
    e.preventDefault();
    e.stopPropagation();
  }, { capture: true });

  // ---------- Pop-out: the poster grows into a card in the middle ----------
  const rectOf = (e: Element) => e.getBoundingClientRect();
  function popFrames(card: HTMLAnchorElement) {
    const d = rectOf(pop), r = rectOf(posterOf(card));
    const inset = `inset(${r.top - d.top}px ${d.right - r.right}px ${d.bottom - r.bottom}px ${r.left - d.left}px round 8px)`;
    const p = pop.querySelector(".pk-poster");
    const pr = p ? rectOf(p) : r;
    const flip = `translate(${r.left - pr.left}px, ${r.top - pr.top}px) scale(${r.width / pr.width})`;
    return { clip: [{ clipPath: inset }, { clipPath: "inset(0 round 12px)" }], flip: [{ transform: flip }, { transform: "none" }] };
  }
  const popText = () => pop.querySelectorAll(".pk-head > div, .pk-head ~ *");
  function openPop(card: HTMLAnchorElement) {
    held = card;
    pop.replaceChildren(...details(card, "pk-pop-title", true, closePop));
    pop.showModal();
    pop.scrollTop = 0;
    if (still) return;
    const f = popFrames(card);
    const o = { duration: 340, easing: EASE };
    pop.animate(f.clip, o);
    pop.querySelector(".pk-poster")?.animate(f.flip, o);
    popText().forEach((e) => e.animate([{ opacity: 0 }, { opacity: 0, offset: 0.35 }, { opacity: 1 }], o));
    pop.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, pseudoElement: "::backdrop" });
  }
  function closePop() {
    if (!pop.open || !held) return;
    const card = held;
    held = null;
    if (still) return pop.close();
    const f = popFrames(card);
    const o = { duration: 260, easing: EASE, fill: "forwards" as const };
    popText().forEach((e) => e.animate([{ opacity: 1 }, { opacity: 0, offset: 0.5 }, { opacity: 0 }], o));
    pop.querySelector(".pk-poster")?.animate([...f.flip].reverse(), o);
    pop.animate([{ opacity: 1 }, { opacity: 0 }], { ...o, pseudoElement: "::backdrop" });
    pop.animate([...f.clip].reverse(), o).finished.then(() => {
      pop.close();
      pop.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    });
  }
  pop.addEventListener("cancel", (e) => { e.preventDefault(); closePop(); }); // Esc
  pop.addEventListener("click", (e) => { if (e.target === pop) closePop(); });

  // ---------- Inline: a panel under the row, pointing at the poster ----------
  const track = document.querySelector<HTMLElement>(".row .track");
  track?.after(panel);
  const aimCaret = () => {
    if (!held || panel.hidden) return;
    const r = rectOf(posterOf(held)), p = rectOf(panel);
    panel.style.setProperty("--caret", `${Math.max(16, Math.min(p.width - 16, r.left + r.width / 2 - p.left))}px`);
  };
  track?.addEventListener("scroll", aimCaret, { passive: true });
  function openPanel(card: HTMLAnchorElement) {
    if (held === card && !panel.hidden) return closePanel();
    held?.classList.remove("pk-on");
    const was = !panel.hidden;
    held = card;
    card.classList.add("pk-on");
    card.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "instant" });
    panel.replaceChildren(...details(card, "pk-panel-title", false, closePanel));
    panel.hidden = false;
    aimCaret();
    if (!still) {
      const h = panel.offsetHeight;
      panel.animate(was ? [{ opacity: 0.4 }, { opacity: 1 }] : [{ height: "0px", opacity: 0 }, { height: `${h}px`, opacity: 1 }], { duration: 260, easing: EASE });
    }
    // Bring all of it into view if it runs off the bottom.
    setTimeout(() => panel.scrollIntoView({ block: "nearest", behavior: still ? "instant" : "smooth" }), still ? 0 : 260);
  }
  function closePanel() {
    if (panel.hidden || !held) return;
    held.classList.remove("pk-on");
    held = null;
    const done = () => { panel.hidden = true; panel.replaceChildren(); };
    if (still) return done();
    panel.animate([{ height: `${panel.offsetHeight}px`, opacity: 1 }, { height: "0px", opacity: 0 }], { duration: 200, easing: EASE }).finished.then(done);
  }
  addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) closePanel(); });
</script>

<style is:global>
  /* No callout, selection or image drag where a finger holds. */
  .track a.card, .track a.card *, .pk-pop, .pk-pop *, .pk-panel, .pk-panel * { -webkit-touch-callout: none; -webkit-user-drag: none; }
  .track a.card, .track a.card * { user-select: none; -webkit-user-select: none; }
  .track a.card.pk-pressing .poster { scale: 0.94; transition: scale 0.42s var(--ease); }

  /* The details, in either place. */
  .pk-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); align-items: end; }
  .pk-head:not(:has(.pk-poster)) { grid-template-columns: minmax(0, 1fr); }
  .pk-head .pk-poster { width: 110px; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: var(--radius-media); box-shadow: var(--shadow-1); transform-origin: 0 0; }
  .pk-head h2 { margin: 0; font-size: var(--text-lg); line-height: 1.1; }
  .pk-head .eyebrow { margin: 0 0 var(--space-1); }
  .pk-facts { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: var(--space-2) 0 0; padding: 0; }
  .pk-facts .pill { min-height: 24px; font-size: var(--text-xs); }
  .pk-why { margin: var(--space-4) 0 var(--space-2); font-weight: 600; }
  .pk-sum { margin: 0; color: var(--muted); font-size: var(--text-sm); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .pk-leads-label { margin: var(--space-6) 0 var(--space-2); }
  .pk-leads { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); margin: 0; padding: 0; }
  .pk-lead { display: grid; gap: var(--space-1); color: inherit; text-decoration: none; font-size: var(--text-xs); line-height: 1.2; }
  .pk-lead span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pk-lead .poster-ph { font-size: 10px; }
  .pk-actions { display: flex; gap: var(--space-2); margin-top: var(--space-6); }
  .pk-actions > * {
    flex: 1; display: inline-flex; justify-content: center; align-items: center; min-height: 44px; border-radius: var(--radius-pill);
    font: 700 var(--text-sm) var(--font-label); text-decoration: none; cursor: pointer;
  }
  .pk-open { background: var(--accent); color: #17130a; border: 1px solid var(--accent); }
  .pk-close { background: none; color: var(--text); border: 1px solid var(--line); }

  /* Pop-out: a card in the middle of a dimmed page. */
  .pk-pop {
    width: min(380px, calc(100vw - 2 * var(--gutter))); max-height: 86dvh; margin: auto; padding: var(--space-4);
    border: 1px solid var(--line); border-radius: 12px; background: color-mix(in srgb, #fff 7%, var(--bg)); color: var(--text);
    overflow-y: auto; overscroll-behavior: contain; box-shadow: var(--shadow-2);
  }
  .pk-pop::backdrop { background: rgb(0 0 0 / 0.72); }

  /* Inline: under the row, with a notch pointing up at the poster. */
  .pk-panel {
    position: relative; margin: var(--space-2) var(--gutter) 0; padding: var(--space-4);
    border: 1px solid var(--line); border-radius: var(--radius-media); background: color-mix(in srgb, #fff 6%, var(--bg));
  }
  .pk-panel[hidden] { display: none; }
  .pk-panel::before {
    content: ""; position: absolute; top: -7px; left: var(--caret, 50%); width: 12px; height: 12px; translate: -50% 0; rotate: 45deg;
    background: inherit; border-left: 1px solid var(--line); border-top: 1px solid var(--line);
  }
  @media (min-width: 1132px) { .pk-panel { max-width: 1068px; margin-inline: auto; } }
  .track a.card.pk-on :is(.poster, .poster-ph) { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* The prototype switch. */
  body { padding-bottom: 64px; }
  .pk-bar {
    position: fixed; left: 50%; bottom: max(12px, env(safe-area-inset-bottom)); translate: -50% 0; z-index: 90;
    display: flex; align-items: center; gap: var(--space-2); padding: 6px 6px 6px var(--space-3); white-space: nowrap;
    border: 1px solid var(--line); border-radius: var(--radius-pill); background: #111318; font-size: var(--text-xs);
    box-shadow: var(--shadow-2);
  }
  .pk-bar b { color: var(--accent); letter-spacing: 0.08em; }
  .pk-bar a { padding: 6px var(--space-3); border-radius: 4px; color: var(--text); text-decoration: none; font-weight: 600; }
  .pk-bar a.on { background: var(--accent); color: #17130a; }
</style>
