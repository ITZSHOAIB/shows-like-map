---
// A row that scrolls sideways (the matches, a step further out, the home page's time rows): wrap its .track in this.
// Its edges fade where there's more to see, on every screen. Touch and trackpads swipe it natively. A mouse grabs it:
// the row follows the mouse and flings on with the speed it's let go at, then snaps to a card; a scrubber under it shows
// how much is in view and where, and jumps on a click. Keyboard users Tab along the cards, which scroll themselves into
// view, so the scrubber is for the pointer only and hidden from screen readers (decision 0013).
---

<div class="rail">
  <slot />
  <div class="rail-scrub" aria-hidden="true" hidden><span></span></div>
</div>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  for (const rail of document.querySelectorAll<HTMLElement>(".rail")) {
    const track = rail.querySelector<HTMLElement>(".track")!;
    const bar = rail.querySelector<HTMLElement>(".rail-scrub")!;
    const thumb = bar.firstElementChild as HTMLElement;
    let frame = 0;
    // Which edges have more past them, and the scrubber: the share of the row in view, and where it is.
    const update = () => {
      frame = 0;
      const max = track.scrollWidth - track.clientWidth;
      rail.toggleAttribute("data-l", track.scrollLeft > 4);
      rail.toggleAttribute("data-r", max > 4 && track.scrollLeft < max - 4);
      bar.hidden = max <= 4;
      const share = track.clientWidth / track.scrollWidth;
      thumb.style.width = `${share * 100}%`;
      thumb.style.left = `${max > 0 ? (track.scrollLeft / max) * (1 - share) * 100 : 0}%`;
    };
    const soon = () => (frame ||= requestAnimationFrame(update));
    track.addEventListener("scroll", soon, { passive: true });
    new ResizeObserver(soon).observe(track);
    // Filters hide cards without resizing the row; a hidden row (display: none) has no edges at all.
    document.addEventListener("change", soon);
    document.addEventListener("reset", () => setTimeout(soon));
    addEventListener("pageshow", soon);

    // While the mouse moves the row, snapping would fight it; it lines the nearest card up once the row comes to rest.
    const loose = (on: boolean) => (track.style.scrollSnapType = on ? "none" : "");

    // The scrubber: press anywhere on it to centre the view there, and drag along it.
    bar.addEventListener("pointerdown", (e) => {
      const b = bar.getBoundingClientRect();
      const share = track.clientWidth / track.scrollWidth;
      const to = (x: number) => (((x - b.left) / b.width - share / 2) / (1 - share)) * (track.scrollWidth - track.clientWidth);
      loose(true);
      track.scrollLeft = to(e.clientX);
      bar.setPointerCapture(e.pointerId);
      const move = (m: PointerEvent) => (track.scrollLeft = to(m.clientX));
      bar.addEventListener("pointermove", move);
      bar.addEventListener("pointerup", () => { bar.removeEventListener("pointermove", move); loose(false); }, { once: true });
    });

    // Grabbing the row. A press that barely moves is a click (or a hold, which peeks); past a few pixels it's a drag,
    // and the click its release makes goes nowhere.
    let down: { x: number; left: number; t: number; v: number; moved: boolean } | null = null;
    let fling = 0;
    let swallow = false;
    track.addEventListener("click", (e) => {
      if (swallow) { swallow = false; e.preventDefault(); e.stopPropagation(); }
    }, { capture: true });
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      cancelAnimationFrame(fling);
      swallow = false;
      down = { x: e.clientX, left: track.scrollLeft, t: performance.now(), v: 0, moved: false };
    });
    addEventListener("pointermove", (e) => {
      if (!down) return;
      // A hold that opened a peek: the mouse drags the peek now, not the row under it.
      if (!down.moved && document.querySelector("dialog[open]")) return void (down = null);
      const dx = e.clientX - down.x;
      if (!down.moved && Math.abs(dx) < 6) return;
      if (!down.moved) { down.moved = true; loose(true); rail.classList.add("grabbing"); }
      const now = performance.now(), from = track.scrollLeft;
      track.scrollLeft = down.left - dx;
      // The speed it's moving at (px per ms), smoothed over the last few moves, for the fling.
      down.v = 0.8 * ((track.scrollLeft - from) / Math.max(now - down.t, 1)) + 0.2 * down.v;
      down.t = now;
    });
    const letGo = () => {
      if (!down) return;
      const { moved, v } = down;
      down = null;
      rail.classList.remove("grabbing");
      if (!moved) return;
      swallow = true;
      setTimeout(() => (swallow = false)); // released off the row: no click comes to swallow
      let speed = still.matches ? 0 : v * 16; // px per frame
      const step = () => {
        speed *= 0.94;
        track.scrollLeft += speed;
        if (Math.abs(speed) > 0.5) fling = requestAnimationFrame(step);
        else loose(false);
      };
      step();
    };
    addEventListener("pointerup", letGo);
    addEventListener("pointercancel", letGo);
    track.addEventListener("dragstart", (e) => e.preventDefault()); // the browser's own drag of a link or poster
    update();
  }
</script>

<style is:global>
  .rail {
    position: relative;
    --rail-fade: 28px;
  }
  @media (min-width: 720px) { .rail { --rail-fade: 64px; } }
  .rail > .track {
    overscroll-behavior-x: contain; /* a sideways swipe at the end doesn't turn into Back */
    mask-image: linear-gradient(
      to right, transparent, #000 var(--fade-l, 0px), #000 calc(100% - var(--fade-r, 0px)), transparent
    );
  }
  .rail[data-l] { --fade-l: var(--rail-fade); }
  .rail[data-r] { --fade-r: var(--rail-fade); }

  /* A mouse grabs the row. Phones and touch screens swipe, so they get neither the cursor nor the scrubber. */
  .rail-scrub { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .rail > .track { cursor: grab; }
    .rail.grabbing > .track { cursor: grabbing; user-select: none; }
    .rail.grabbing a { pointer-events: none; }
    .rail-scrub {
      display: block; position: relative; height: 4px; cursor: pointer;
      margin: var(--space-2) max(var(--gutter), calc((100% - 1100px) / 2 + var(--gutter))) 0;
      border-radius: 2px; background: rgb(255 255 255 / 0.1);
    }
    .rail-scrub::before { content: ""; position: absolute; inset: -8px 0; } /* a taller target than it looks */
    .rail-scrub > span {
      position: absolute; top: 0; bottom: 0; border-radius: 2px; background: rgb(255 255 255 / 0.45);
      transition: background-color var(--fast);
    }
    .rail-scrub:hover > span { background: var(--accent); }
    .rail-scrub[hidden] { display: none; }
  }
  @media (forced-colors: active) {
    .rail > .track { mask-image: none; }
    .rail-scrub { forced-color-adjust: none; background: Canvas; outline: 1px solid GrayText; }
    .rail-scrub > span { background: CanvasText; }
    .rail-scrub:hover > span { background: Highlight; }
  }
</style>
