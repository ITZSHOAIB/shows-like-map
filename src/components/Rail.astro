---
// A row that scrolls sideways (the matches, a step further out, the home page's time rows): wrap its .track in this.
// Its edges fade where there's more to see, on every screen. With a mouse, arrows page it by whole cards; touch
// and trackpads swipe it natively, and keyboard users Tab along the cards, which scroll themselves into view. The arrows
// are for the pointer only, so they're hidden from screen readers and out of the Tab order.
import Icon from "./Icon.astro";
---

<div class="rail">
  <slot />
  <button type="button" class="rail-btn prev" tabindex="-1" aria-hidden="true"><Icon name="caret-left" /></button>
  <button type="button" class="rail-btn next" tabindex="-1" aria-hidden="true"><Icon name="caret-right" /></button>
</div>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  for (const rail of document.querySelectorAll<HTMLElement>(".rail")) {
    const track = rail.querySelector<HTMLElement>(".track")!;
    let frame = 0;
    // Which edges have more past them, and where the arrows sit: halfway down the posters.
    const update = () => {
      frame = 0;
      const max = track.scrollWidth - track.clientWidth;
      rail.toggleAttribute("data-l", track.scrollLeft > 4);
      rail.toggleAttribute("data-r", max > 4 && track.scrollLeft < max - 4);
      const poster = track.querySelector<HTMLElement>("li:not([hidden]) :is(.poster, .poster-ph)");
      if (poster?.offsetHeight) rail.style.setProperty("--rail-mid", `${poster.offsetTop + poster.offsetHeight / 2}px`);
    };
    const soon = () => (frame ||= requestAnimationFrame(update));
    track.addEventListener("scroll", soon, { passive: true });
    new ResizeObserver(soon).observe(track);
    // Filters hide cards without resizing the row; a hidden row (display: none) has no edges at all.
    document.addEventListener("change", soon);
    document.addEventListener("reset", () => setTimeout(soon));
    addEventListener("pageshow", soon);
    // Paging, as streaming apps do it: by the cards whole inside the page column, never by a share of the window (on a
    // wide screen that skipped cards). Next brings the first card not wholly in view to the column's start; back brings
    // the card before the first one wholly in view to its end. Every page lands on a snap point, so snapping can't move
    // it on, and nothing is skipped or shown twice. A click while it's still moving pages on from where it's going.
    let goal: number | null = null;
    const pageFrom = (dir: 1 | -1) => {
      const pad = parseFloat(getComputedStyle(track).paddingLeft);
      const from = goal ?? track.scrollLeft;
      const lo = from, hi = from + track.clientWidth - 2 * pad; // the column, in the positions that put a card at its start
      const base = track.getBoundingClientRect().left - track.scrollLeft + pad;
      const cards = [...track.children].flatMap((li) => {
        const b = li.getBoundingClientRect();
        return b.width ? [{ at: b.left - base, end: b.right - base }] : [];
      });
      const max = track.scrollWidth - track.clientWidth;
      if (dir > 0) {
        const next = cards.find((c) => c.end > hi + 1);
        return next ? Math.min(next.at, max) : max;
      }
      const first = cards.findIndex((c) => c.at >= lo - 1);
      if (first <= 0) return 0;
      const end = cards[first - 1].end, width = hi - lo;
      const start = cards.find((c) => end - c.at <= width + 1)!;
      return Math.max(start.at, 0);
    };
    const settle = () => (goal = null);
    track.addEventListener("scrollend", settle);
    track.addEventListener("pointerdown", settle); // a drag or a wheel takes over from the arrows
    track.addEventListener("wheel", settle, { passive: true });
    for (const [cls, dir] of [["prev", -1], ["next", 1]] as const) {
      rail.querySelector(`.${cls}`)!.addEventListener("click", () => {
        const to = pageFrom(dir);
        if (Math.abs(to - track.scrollLeft) < 1) return settle();
        goal = to;
        track.scrollTo({ left: to, behavior: still.matches ? "auto" : "smooth" });
        if (still.matches) settle();
      });
    }
    update();
  }
</script>

<style is:global>
  .rail {
    position: relative;
    --rail-fade: 28px;
  }
  @media (min-width: 720px) { .rail { --rail-fade: 64px; } }
  .rail > .track {
    overscroll-behavior-x: contain; /* a sideways swipe at the end doesn't turn into Back */
    mask-image: linear-gradient(
      to right, transparent, #000 var(--fade-l, 0px), #000 calc(100% - var(--fade-r, 0px)), transparent
    );
  }
  .rail[data-l] { --fade-l: var(--rail-fade); }
  .rail[data-r] { --fade-r: var(--rail-fade); }

  .rail-btn {
    position: absolute; z-index: 1; top: var(--rail-mid, 40%); translate: 0 -50%;
    display: none; place-items: center; width: 44px; height: 64px; padding: 0;
    border: 1px solid var(--pill-line); border-radius: var(--radius-pill); color: var(--text); cursor: pointer;
    background: rgb(7 8 12 / 0.72); backdrop-filter: blur(10px); box-shadow: var(--shadow-1);
    opacity: 0; transition: opacity var(--slow) var(--ease), scale 0.15s var(--ease), border-color 0.15s;
  }
  .rail-btn .icon { width: 22px; height: 22px; }
  /* At the window's edges, over the faded ends: cards run past the page column, so anywhere further in sits on a poster. */
  .rail-btn.prev { left: 8px; }
  .rail-btn.next { right: 8px; }
  .rail-btn:hover { border-color: var(--accent); }
  .rail-btn:active { scale: 0.92; }
  /* A mouse on a screen wider than a phone gets arrows, where there's more that way; brighter while the pointer is on the row.
     Phones never do: a swipe is the way there, and an arrow would sit on the next poster. */
  @media (hover: hover) and (pointer: fine) and (min-width: 720px) {
    .rail[data-l] .prev, .rail[data-r] .next { display: grid; opacity: 0.55; }
    .rail:hover[data-l] .prev, .rail:hover[data-r] .next { opacity: 1; }
  }
  @media (forced-colors: active) {
    .rail > .track { mask-image: none; }
    .rail-btn { border-color: ButtonText; background: ButtonFace; color: ButtonText; }
  }
</style>
