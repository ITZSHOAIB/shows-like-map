---
// PROTOTYPE variant B, "Reason rows": every row is a reason ("Because it's about time travel"),
// so the reasons themselves become the way you navigate.
import { reasonRows, poster, reasonText, lengthLabel, filterAttrs, STATUS_LABEL, IMG, type Show } from "../../lib/data";

interface Props { show: Show }
const { show } = Astro.props;
const rows = reasonRows(show);
---
<section class="hero">
  {show.backdrop && <img class="backdrop" src={`${IMG}w780${show.backdrop}`} alt="" />}
  <div class="wrap hero-in">
    {show.poster
      ? <img src={poster(show.poster, "w342")} alt={`${show.name} poster`} class="poster h-poster" data-hero-poster style="view-transition-name: hero-poster" />
      : <div class="poster-ph h-poster" data-hero-poster style="view-transition-name: hero-poster">{show.name}</div>}
    <div class="h-text">
      <p class="eyebrow">If you liked</p>
      <h1>{show.name}</h1>
      <p class="meta">
        {show.year} · <span class={`badge ${show.status}`}>{STATUS_LABEL[show.status]}</span>
        {lengthLabel(show) && <> · {lengthLabel(show)}</>} · {show.genres.slice(0, 3).join(", ")}
      </p>
      <p class="ov">{show.overview}</p>
      <div class="providers">
        {show.providers.length
          ? show.providers.map((p) => <img src={`${IMG}w92${p.logo}`} alt={p.name} title={p.name} />)
          : <span class="muted" style="font-size:12px">Not streaming in India</span>}
      </div>
    </div>
  </div>
</section>

<div class="rows">
  {rows.map((row) => (
    <section class="row" data-row>
      <header class="wrap row-head">
        <h2>{row.title}</h2>
        <span class="muted row-count" data-row-count>{row.items.length}</span>
        <span class="row-nav">
          <button data-scroll="-1" aria-label="Scroll left">‹</button>
          <button data-scroll="1" aria-label="Scroll right">›</button>
        </span>
      </header>
      <div class="track" data-track>
        {row.items.map((m) => (
          <a class="card" href={`/prototype/rows/${m.show.slug}`} data-hop={m.show.id} {...filterAttrs(m.show)}>
            {m.show.poster ? <img src={poster(m.show.poster, "w185")} alt="" class="poster" loading="lazy" /> : <div class="poster-ph">{m.show.name}</div>}
            <b class="c-title">{m.show.name}</b>
            <span class="c-meta"><span class={`badge ${m.show.status}`}>{STATUS_LABEL[m.show.status].split(" ")[0]}</span> {lengthLabel(m.show) || m.show.year}</span>
            {row.key === "best" && <span class="c-why">{m.reasons.slice(0, 2).map(reasonText).join(" · ")}</span>}
            {m.show.providers.length > 0 && (
              <span class="c-prov">{m.show.providers.slice(0, 3).map((p) => <img src={`${IMG}w92${p.logo}`} alt={p.name} />)}</span>
            )}
          </a>
        ))}
      </div>
      <p class="wrap row-empty muted" hidden>All hidden by your filters</p>
    </section>
  ))}
</div>

<style>
  .hero { position: relative; overflow: hidden; padding: 12px 0 26px; }
  .backdrop {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.32; z-index: -1;
    mask-image: linear-gradient(to bottom, #000 30%, transparent);
  }
  .hero-in { display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: end; }
  @media (min-width: 720px) { .hero-in { grid-template-columns: 200px 1fr; gap: 28px; } }
  .h-poster { box-shadow: 0 20px 50px rgb(0 0 0 / 0.6), 0 0 60px rgb(var(--tint) / 0.5); }
  .eyebrow { margin: 0; color: var(--accent); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; }
  .h-text h1 { font-size: clamp(26px, 6vw, 52px); line-height: 1.02; }
  .meta { margin: 6px 0; font-size: 13px; color: var(--muted); }
  .ov { font-size: 14px; margin: 8px 0 10px; max-width: 60ch; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 719px) { .ov { grid-column: 1 / -1; } }

  .rows { display: grid; gap: 22px; }
  .row { min-width: 0; }
  .row-head { display: flex; align-items: baseline; gap: 10px; }
  .row-head h2 { font-size: 18px; }
  .row-count { font-size: 12px; }
  .row-nav { margin-left: auto; display: none; gap: 4px; }
  @media (hover: hover) { .row-nav { display: flex; } }
  .row-nav button { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); cursor: pointer; }

  .track {
    display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding: 10px max(16px, calc((100vw - 1100px) / 2 + 16px)) 14px; scroll-padding-inline: 16px;
    perspective: 900px;
  }
  .card {
    flex: none; width: 128px; scroll-snap-align: start; display: grid; gap: 4px; align-content: start;
    transition: translate 0.25s, opacity 0.3s;
    animation: tilt-in linear both, tilt-out linear both; animation-timeline: view(inline), view(inline); animation-range: entry, exit;
  }
  @media (min-width: 720px) { .card { width: 150px; } }
  .card:hover { translate: 0 -4px; }
  .card .poster { box-shadow: 0 8px 20px rgb(0 0 0 / 0.4); }
  .card[data-out] { display: none; }
  .c-title { font-size: 13px; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c-meta, .c-why { font-size: 11.5px; color: var(--muted); }
  .c-why { color: var(--accent); }
  .c-prov { display: flex; gap: 4px; }
  .c-prov img { width: 18px; height: 18px; border-radius: 5px; }
  .row-empty { font-size: 13px; margin: 0; }
  /* Cards lean in as they enter and out as they leave, and sit flat while fully in view: a scroll-driven coverflow, pure CSS. */
  @keyframes tilt-in { from { transform: rotateY(32deg) scale(0.88); opacity: 0.35; } }
  @keyframes tilt-out { to { transform: rotateY(-32deg) scale(0.88); opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .card { animation: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
    const track = row.querySelector<HTMLElement>("[data-track]")!;
    row.querySelectorAll<HTMLButtonElement>("[data-scroll]").forEach((b) =>
      b.addEventListener("click", () => track.scrollBy({ left: Number(b.dataset.scroll) * track.clientWidth * 0.8, behavior: "smooth" })),
    );
  });
  // Rows count only what passes the filters, and say so when a filter empties a row.
  document.addEventListener("filters:change", () => {
    document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
      const cards = row.querySelectorAll(".card");
      const shown = row.querySelectorAll(".card:not([data-out])").length;
      row.querySelector("[data-row-count]")!.textContent = shown === cards.length ? `${shown}` : `${shown} of ${cards.length}`;
      (row.querySelector(".row-empty") as HTMLElement).hidden = shown > 0;
    });
  });
</script>
