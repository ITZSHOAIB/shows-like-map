---
// A show on the home page: poster, name, and year · status · hours, as a match card shows them (MatchCard.astro).
// The page's script builds the same markup for search results (index.astro), so these styles are global.
import { hours, STATUS_LABEL, type Show } from "../lib/catalogue";

interface Props {
  show: Show;
  eager?: boolean;
}
const { show, eager } = Astro.props;
const year = show.premiered?.slice(0, 4);
---

<a class="tile" href={`/shows/${show.slug}/`}>
  {
    show.poster ? (
      <img class="poster" src={show.poster} alt="" width="210" height="295" loading={eager ? "eager" : "lazy"} decoding="async" />
    ) : (
      <span class="poster-ph" aria-hidden="true">{show.name}</span>
    )
  }
  <b class="t-name">{show.name}</b>
  <span class={`t-meta s-${show.status}`}>
    {year && <span class="t-year">{year}</span>}
    <span class="dot"></span>
    {STATUS_LABEL[show.status]}
    {show.minutes !== null && <> · {hours(show.minutes)}</>}
  </span>
</a>

<style is:global>
  .tile { display: grid; gap: 2px; align-content: start; min-width: 0; }
  .tile :is(.poster, .poster-ph) { margin-bottom: var(--space-1); transition: scale var(--slow) var(--ease), box-shadow var(--slow); box-shadow: var(--shadow-1); }
  .tile:hover :is(.poster, .poster-ph), .tile:focus-visible :is(.poster, .poster-ph) { scale: 1.03; box-shadow: 0 0 0 2px var(--accent), 0 12px 28px rgb(0 0 0 / 0.45); }
  /* Keyboard focus rings the poster, as on match cards: a ring round the whole tile would be clipped in a scrolling row. */
  .tile:focus-visible { outline: none; }
  .tile:focus-visible :is(.poster, .poster-ph) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .tile:active :is(.poster, .poster-ph) { scale: 0.96; }
  .tile .t-name {
    font: 700 var(--text-sm)/1.2 var(--font-display); letter-spacing: var(--display-tracking); text-transform: var(--display-case);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;
  }
  .tile .t-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 5px; font-size: var(--text-xs); color: var(--muted); font-variant-numeric: var(--nums); }
  /* The year on a line of its own: a narrow tile would otherwise break between the year and the status. */
  .tile .t-year { flex-basis: 100%; }
  .tile .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--s); flex: none; }
</style>
