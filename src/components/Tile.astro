---
// A show on the home page: poster (with its TVmaze rating), name, and year · status · hours, as a match card shows them (MatchCard.astro).
// The page's script builds the same markup for search results (index.astro), so its styles are in global.css (with /kept/, which builds them too).
import { hours, STATUS_LABEL, type Show } from "../lib/catalogue";
import Icon from "./Icon.astro";

interface Props {
  show: Show;
  eager?: boolean;
}
const { show, eager } = Astro.props;
const year = show.premiered?.slice(0, 4);
---

<a class="tile" href={`/shows/${show.slug}/`}>
  {
    show.poster ? (
      <img class="poster" src={show.poster} alt="" width="210" height="295" loading={eager ? "eager" : "lazy"} decoding="async" />
    ) : (
      <span class="poster-ph" aria-hidden="true">{show.name}</span>
    )
  }
  <b class="t-name">{show.name}</b>
  <span class={`t-meta s-${show.status}`}>
    {year && <span class="t-year">{year}</span>}
    <span class="dot"></span>
    {STATUS_LABEL[show.status]}
    {show.minutes !== null && <> · {hours(show.minutes)}</>}
  </span>
  {show.rating && <span class="rate"><Icon name="star" /><span class="sr-only">rated </span>{show.rating.toFixed(1)}</span>}
</a>
