---
// PROTOTYPE, remove when a direction is picked. Three design directions on the real pages, switched with ?v=marquee,
// ?v=guide or ?v=transit (kept for the tab), or a "v" cookie for the tests (no bar then). See _directions.css.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/overpass";
import "../styles/_directions.css";
---

<script is:inline>
  (() => {
    const q = new URLSearchParams(location.search).get("v");
    try { if (q) sessionStorage.setItem("slm:v", q); } catch {}
    let v = null;
    try { v = sessionStorage.getItem("slm:v"); } catch {}
    const bar = !!v;
    v ||= (document.cookie.match(/(?:^|; )v=(\w+)/) || [])[1];
    if (v && v !== "now") document.documentElement.dataset.v = v;
    if (bar) document.documentElement.dataset.vBar = "";
  })();
</script>
<script is:inline>
  addEventListener("DOMContentLoaded", () => {
    if (!("vBar" in document.documentElement.dataset)) return;
    const now = document.documentElement.dataset.v || "now";
    const bar = document.createElement("nav");
    bar.className = "v-bar";
    bar.ariaLabel = "Prototype: design direction";
    bar.innerHTML = "<b>Prototype</b>" + ["now", "marquee", "guide", "transit"]
      .map((v) => `<button type="button" data-v="${v}" aria-pressed="${v === now}">${v[0].toUpperCase() + v.slice(1)}</button>`).join("");
    bar.addEventListener("click", (e) => {
      const v = e.target.closest("button")?.dataset.v;
      if (!v) return;
      try { sessionStorage.setItem("slm:v", v); } catch {}
      if (v === "now") delete document.documentElement.dataset.v;
      else document.documentElement.dataset.v = v;
      bar.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v === v)));
    });
    document.body.append(bar);
  });
</script>
