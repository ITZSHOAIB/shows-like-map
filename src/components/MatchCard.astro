---
// One match in a row: poster, name, year, status and hours, and the one-line "why".
// Matches outside the catalogue have no page, poster or facts, so they show as a plain card (decision in #2).
import { hours, STATUS_LABEL, type Show } from "../lib/catalogue";
import type { Match } from "../lib/matches";

interface Props {
  match: Match;
  show?: Show; // the match's own catalogue record, when it has a page
  eager?: boolean;
}
const { match, show, eager } = Astro.props;
const Tag = show ? "a" : "div";
---

<Tag class="card" href={show && `/shows/${show.slug}/`}>
  {
    show?.poster ? (
      <img class="poster" src={show.poster} alt="" width="210" height="295" loading={eager ? "eager" : "lazy"} decoding="async" />
    ) : (
      <span class="poster-ph" aria-hidden="true">{match.name}</span>
    )
  }
  <b class="c-title">{match.name}</b>
  {
    show ? (
      <span class={`c-meta s-${show.status}`}>
        {show.premiered && <>{show.premiered.slice(0, 4)} ·</>}
        <span class="dot" />
        {STATUS_LABEL[show.status]}
        {show.minutes !== null && <> · {hours(show.minutes)}</>}
      </span>
    ) : (
      match.year && <span class="c-meta">{match.year}</span>
    )
  }
  <span class="c-why">{match.why}</span>
</Tag>

<style>
  .card { width: 140px; display: grid; gap: var(--space-1); align-content: start; }
  @media (min-width: 720px) { .card { width: 160px; } }
  a.card .poster { transition: scale var(--slow) var(--ease), box-shadow var(--slow); box-shadow: var(--shadow-1); }
  a.card:hover .poster, a.card:focus-visible .poster { scale: 1.03; box-shadow: 0 0 0 2px var(--accent), 0 12px 28px rgb(0 0 0 / 0.45); }
  /* Keyboard focus rings the poster: a ring round the whole card would be clipped by the scrolling track. */
  a.card:focus-visible { outline: none; }
  a.card:focus-visible :is(.poster, .poster-ph) { outline: 2px solid var(--accent); outline-offset: 3px; }
  a.card:active .poster { scale: 0.96; }
  .c-title { margin-top: var(--space-1); font: 700 var(--text-md)/1.2 var(--font-display); letter-spacing: var(--display-tracking); text-transform: var(--display-case); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 5px; font-size: var(--text-xs); color: var(--muted); font-variant-numeric: var(--nums); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--s); flex: none; }
  .c-why { font-size: var(--text-sm); line-height: 1.35; color: var(--text); opacity: 0.85; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
</style>
