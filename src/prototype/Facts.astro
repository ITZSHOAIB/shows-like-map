---
// PROTOTYPE: the verdict in words, and the few facts behind it. Read first; the picture under it is the proof.
import { endingWords, hoursLabel, type Arc } from "./arc";
const { arc } = Astro.props as { arc: Arc };
const s = arc.slowStart, f = arc.fadeAfter;
---

<p class="verdict">{arc.verdict}</p>
<ul class="pf-facts">
  {arc.best && arc.seasons.length >= 2 && <li><b>★ Best</b> season {arc.best.n}</li>}
  {s && <li><b>Gets going</b> {s.season ? `season ${s.season}` : `episode ${s.episode}`} · {hoursLabel(s.hours)} in</li>}
  {f && <li><b>Good part</b> seasons 1–{f.season} · {hoursLabel(f.hours)}, fine to stop there</li>}
  <li><b>Ending</b> {endingWords(arc.ending, arc.finale)}</li>
  <li><b>All of it</b> {hoursLabel(arc.hours)}</li>
</ul>
