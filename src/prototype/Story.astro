---
// PROTOTYPE (E): the arc told as a few cards, on request: how it starts, where it peaks, where it dips, how it ends.
// Each card lights up its stretch of the run.
import { endingWords, hoursLabel, type Arc } from "./arc";
import { road } from "./draw";
const { arc, id } = Astro.props as { arc: Arc; id: string };
const W = 300, H = 60;
const { x, paths } = road(arc, W, H);
const first = arc.seasons[0], last = arc.seasons.at(-1)!;
const cards = [
  {
    head: "How it starts",
    text: arc.slowStart
      ? `It takes a while. Give it until ${arc.slowStart.season ? `season ${arc.slowStart.season}` : `episode ${arc.slowStart.episode}`}, about ${hoursLabel(arc.slowStart.hours)} in.`
      : "Good from the first episode. No warming up needed.",
    from: 0, to: arc.slowStart?.hours || Math.min(first.end, arc.hours * 0.15),
  },
  arc.best && arc.seasons.length >= 2 && {
    head: "Its peak",
    text: `Season ${arc.best.n}, ${hoursLabel(arc.best.start)} to ${hoursLabel(arc.best.end)} in.`,
    from: arc.best.start, to: arc.best.end,
  },
  arc.fadeAfter && {
    head: "Where it dips",
    text: `After season ${arc.fadeAfter.season} it slides. Stopping there, at ${hoursLabel(arc.fadeAfter.hours)}, is a fine place to finish.`,
    from: arc.fadeAfter.hours, to: arc.hours,
  },
  {
    head: "How it ends",
    text: `${endingWords(arc.ending, arc.finale).replace(/^./, (c) => c.toUpperCase())}. ${hoursLabel(arc.hours)} all told.`,
    from: arc.seasons.length > 1 ? last.start : arc.hours * 0.85, to: arc.hours,
  },
].filter(Boolean) as { head: string; text: string; from: number; to: number }[];
---

<div class="pf-story">
  <button type="button" class="pill" aria-expanded="false" aria-controls={`${id}-story`}>Tell me the arc</button>
  <ol id={`${id}-story`} hidden tabindex="0" aria-label="The arc, card by card">
    {cards.map((c, i) => (
      <li style={`--i:${i}`}>
        <p class="eyebrow">{i + 1} of {cards.length} · {c.head}</p>
        <p>{c.text}</p>
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <rect class="good" x={x(c.from)} width={Math.max(x(c.to) - x(c.from), 3)} y="0" height={H} />
          {paths.map((d) => <path class="faint" d={d} vector-effect="non-scaling-stroke" />)}
        </svg>
      </li>
    ))}
  </ol>
</div>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>(".pf-story > button")) {
    b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") !== "true";
      b.setAttribute("aria-expanded", String(open));
      b.textContent = open ? "Hide the arc" : "Tell me the arc";
      document.getElementById(b.getAttribute("aria-controls")!)!.hidden = !open;
    });
  }
</script>
