---
// PROTOTYPE (payoff-prototype): the skyline. The show's own poster, cut into a city: every episode a building as tall
// as its rating, every season a block, a street between. Grey where it's warming up or past its best; the best season
// lit amber. Tap a season to lift it and hear what it is.
import { CEIL, FLOOR, endingWords, hoursLabel, levelOf, round, type Arc, type Season } from "./arc";
const { arc, id, poster, anthology = false } = Astro.props as { arc: Arc; id: string; poster: string | null; anthology?: boolean };

const W = 1000, H = 300, STREET = 7;
const art = poster?.replace("/medium_portrait/", "/original_untouched/") ?? null;
// The shared window: a 6 is a stump, a 9.5 nearly fills the sky (headroom left for the lift and the star).
const top = (v: number) => H - H * (0.05 + 0.83 * ((Math.min(CEIL, Math.max(FLOOR, v)) - FLOOR) / (CEIL - FLOOR)));
const scale = (W - STREET * (arc.seasons.length - 1)) / arc.hours;
const si = new Map(arc.seasons.map((s, i) => [s.n, i]));
const x = (h: number, season: number) => h * scale + si.get(season)! * STREET;
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(2)}%`;

// Lit from where it gets going to where it fades.
const from = arc.slowStart?.hours ?? 0, to = arc.fadeAfter?.hours ?? arc.hours;
const buildings = arc.episodes.map((e) => {
  const s = arc.seasons[si.get(e.season)!];
  const v = e.rating ?? s.mean ?? arc.mean;
  const x0 = x(e.start, e.season), x1 = x(e.end, e.season), gap = Math.min(1.4, (x1 - x0) * 0.22);
  return { e, x0: x0 + gap / 2, x1: x1 - gap / 2, y: top(v), lit: e.start >= from - 0.01 && e.end <= to + 0.01, best: s === arc.best };
});
type Building = (typeof buildings)[number];
const rects = (bs: Building[]) => bs.map((b) => `M${b.x0.toFixed(1)} ${b.y.toFixed(1)}H${b.x1.toFixed(1)}V${H}H${b.x0.toFixed(1)}Z`).join("");
const maskOf = (d: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><path d="${d}"/></svg>`)}")`;

// Blocks: runs of buildings in one season that are all lit or all grey, so a slow first few episodes can grey alone.
const blocks: { season: number; lit: boolean; bs: Building[] }[] = [];
for (const b of buildings) {
  const last = blocks.at(-1);
  if (last && last.season === b.e.season && last.lit === b.lit) last.bs.push(b);
  else blocks.push({ season: b.e.season, lit: b.lit, bs: [b] });
}

// The peak: the tallest building of the best season.
const peak = arc.best ? buildings.filter((b) => b.best && b.e.rating !== null).reduce((a, b) => (b.y < a.y ? b : a)) : null;
const TYPICAL = 7.7; // the middle show in the catalogue

// What each season is, in words: for the caption and for screen readers.
const lastSeason = arc.seasons.at(-1)!;
const role = (s: Season) => {
  if (anthology) return s === arc.best ? "The best of them." : "";
  if (arc.slowStart?.season && s.n < arc.slowStart.season) return "Still warming up.";
  if (arc.slowStart?.season === s.n) return "Where it gets going.";
  if (arc.slowStart?.episode && s === arc.seasons[0]) return `Gets going at episode ${arc.slowStart.episode}.`;
  if (arc.fadeAfter && s.n > arc.fadeAfter.season) {
    return s === lastSeason && arc.finale === "divides" ? "Past its best, and the ending divides viewers." : "Past its best: a fine place to have stopped.";
  }
  if (s === arc.best && arc.seasons.length > 1) return "Its best season.";
  if (s === lastSeason && arc.ending === "ended") return `${endingWords(arc.ending, arc.finale).replace(/^./, (c) => c.toUpperCase())}.`;
  return "";
};
const seasons = arc.seasons.map((s) => {
  const l = x(s.start, s.n), r = x(s.end, s.n);
  const head = s.mean === null ? `Season ${s.n} · too few ratings` : `Season ${s.n} · ${round(s.mean).toFixed(1)} · ${levelOf(s.mean)}`;
  const tail = `${s.eps.length} episodes · ${hoursLabel(s.start)}–${hoursLabel(s.end)} in`;
  return { s, left: pct(l, W), width: pct(r - l, W), wide: (r - l) / W >= 0.035, head, role: role(s), tail };
});

const lit = arc.verdict.replace(/\b(great|good|decent|weak|fades|ends on a high|divides viewers|best: season \d+)\b/gi, "<em>$1</em>");
const tiles = [
  arc.slowStart
    ? { k: "Gets good", v: hoursLabel(arc.slowStart.hours), s: arc.slowStart.season ? `in · season ${arc.slowStart.season}` : `in · episode ${arc.slowStart.episode}` }
    : { k: "Gets good", v: "At once", s: "no warming up" },
  arc.best && arc.seasons.length > 1 ? { k: "Peak", v: `Season ${arc.best.n}`, s: arc.best.start < 0.5 ? `the first ${hoursLabel(arc.best.end)}` : `${hoursLabel(arc.best.start)} to ${hoursLabel(arc.best.end)} in` } : null,
  arc.fadeAfter
    ? { k: "Stop at", v: hoursLabel(arc.fadeAfter.hours), s: `after season ${arc.fadeAfter.season}, if you like` }
    : { k: "All of it", v: hoursLabel(arc.hours), s: endingWords(arc.ending, arc.finale) },
].filter(Boolean) as { k: string; v: string; s: string }[];
const hint = arc.seasons.length > 1 ? "Tap a season to see what it is." : `${arc.episodes.length} episodes, ${hoursLabel(arc.hours)}.`;
---

<section class="sky" style={art ? `--art:url("${art}")` : undefined} aria-labelledby={`${id}-q`}>
  <p class="sky-q eyebrow" id={`${id}-q`}>Is it worth getting through?</p>
  <p class="sky-verdict" set:html={lit} />

  <div class="sky-stage" style={peak ? `--peak:${pct((peak.x0 + peak.x1) / 2, W)}` : undefined}>
    <div class="sky-back" aria-hidden="true"></div>
    <div class="sky-city" aria-hidden="true">
      {arc.best && (
        <svg class="sky-glow" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <defs><filter id={`${id}-blur`} x="-10%" y="-40%" width="120%" height="180%"><feGaussianBlur stdDeviation="10" /></filter></defs>
          <path d={rects(buildings.filter((b) => b.best))} filter={`url(#${id}-blur)`} />
        </svg>
      )}
      {blocks.map((k) => (
        <div class:list={["sky-block", !k.lit && "dim"]} data-season={k.season} style={`--mask:${maskOf(rects(k.bs))};--i:${si.get(k.season)}`}></div>
      ))}
      <svg class="sky-roofs" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
        {arc.seasons.map((s) => (
          <g data-season={s.n} style={`--i:${si.get(s.n)}`} class:list={[s === arc.best && "best"]}>
            {buildings.filter((b) => b.e.season === s.n).map((b) => (
              <path class:list={[!b.lit && "dim"]} d={`M${b.x0.toFixed(1)} ${b.y.toFixed(1)}H${b.x1.toFixed(1)}`} vector-effect="non-scaling-stroke" />
            ))}
          </g>
        ))}
      </svg>
      <span class="sky-typical" style={`top:${pct(top(TYPICAL), H)}`}><b>typical show</b></span>
      {peak && <span class="sky-peak" style={`left:${pct((peak.x0 + peak.x1) / 2, W)};top:${pct(peak.y, H)}`}>★</span>}
    </div>

    <div class="sky-seasons" role="group" aria-label="Seasons">
      {seasons.map((q) => (
        <button type="button" data-season={q.s.n} data-say={`${q.head}${q.role ? ` · ${q.role}` : ""}`} data-tail={q.tail}
          style={`left:${q.left};width:${q.width}`} aria-pressed="false"
          aria-label={`${q.head}. ${q.role} ${q.tail}.`}>
          <span class:list={[q.s === arc.best && "best"]}>{q.wide ? `S${q.s.n}` : ""}</span>
        </button>
      ))}
    </div>
  </div>

  <p class="sky-say"><b>{hint}</b><span></span></p>

  <dl class="sky-tiles">
    {tiles.map((t) => <div><dt>{t.k}</dt><dd><b>{t.v}</b> <span>{t.s}</span></dd></div>)}
  </dl>
</section>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  for (const sky of document.querySelectorAll<HTMLElement>(".sky")) {
    const say = sky.querySelector<HTMLElement>(".sky-say")!;
    const lead = say.querySelector("b")!, rest = say.querySelector("span")!;
    const hint = lead.textContent!;
    const buttons = [...sky.querySelectorAll<HTMLButtonElement>(".sky-seasons button")];
    let picked: string | null = null;
    const show = (n: string | null) => {
      sky.classList.toggle("lifting", n !== null);
      for (const el of sky.querySelectorAll<Element>(".sky-city [data-season]")) el.classList.toggle("up", el.getAttribute("data-season") === n);
      const b = buttons.find((b) => b.dataset.season === n);
      lead.textContent = b ? b.dataset.say! : hint;
      rest.textContent = b ? ` · ${b.dataset.tail}` : "";
    };
    for (const b of buttons) {
      b.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") show(b.dataset.season!); });
      b.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") show(picked); });
      b.addEventListener("focus", () => show(b.dataset.season!));
      b.addEventListener("blur", () => show(picked));
      b.addEventListener("click", () => {
        picked = picked === b.dataset.season ? null : b.dataset.season!;
        for (const o of buttons) o.setAttribute("aria-pressed", String(o.dataset.season === picked));
        show(picked);
      });
    }

    // Arriving: the city rises out of the water, season after season. Once.
    if (still.matches) { sky.classList.add("in", "done"); continue; }
    new IntersectionObserver((seen, io) => {
      if (!seen.some((s) => s.isIntersecting)) return;
      io.disconnect();
      sky.classList.add("in");
      setTimeout(() => sky.classList.add("done"), 1200);
    }, { threshold: 0.35 }).observe(sky.querySelector(".sky-stage")!);
  }
</script>

<style is:global>
  .sky { position: relative; isolation: isolate; padding: var(--space-6) 0 var(--space-4); }
  .sky-q { margin: 0 0 var(--space-2); }
  .sky-verdict {
    margin: 0 0 var(--space-6); max-width: 22ch;
    font: var(--display-weight) clamp(28px, 6.4vw, 52px) / 1.04 var(--font-display); letter-spacing: -0.03em;
    text-wrap: balance; color: #c9cdd9;
  }
  .sky-verdict em { font-style: normal; color: var(--accent); }

  /* The city stands on a waterline; below it, its reflection and the season names. */
  .sky-stage { --ground: clamp(170px, 30vw, 270px); position: relative; height: calc(var(--ground) + 58px); }
  .sky-back {
    position: absolute; inset: -12% -6% 10%; z-index: -1; pointer-events: none;
    background: var(--art, none) center 30% / cover; filter: blur(48px) saturate(1.3); opacity: 0.22;
    mask-image: radial-gradient(60% 70% at 50% 55%, #000 30%, transparent 80%);
  }
  .sky-back::after { content: ""; position: absolute; inset: 0; background: radial-gradient(30% 50% at var(--peak, 50%) 45%, rgb(255 211 107 / 0.35), transparent 70%); }
  .sky-city {
    position: absolute; inset: 0 0 auto; height: var(--ground); overflow: hidden;
    -webkit-box-reflect: below 1px linear-gradient(transparent 76%, rgb(0 0 0 / 0.3));
  }
  .sky-city::after { content: ""; position: absolute; inset: auto 0 0; height: 1px; background: rgb(255 255 255 / 0.18); }
  .sky-block, .sky-glow, .sky-roofs { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sky-block {
    background: linear-gradient(rgb(255 255 255 / 0.14), rgb(255 255 255 / 0.03) 60%), var(--art, linear-gradient(#ffd36b, #8a5a2b)) center 30% / cover;
    -webkit-mask: var(--mask) 0 0 / 100% 100% no-repeat; mask: var(--mask) 0 0 / 100% 100% no-repeat;
    filter: saturate(1.15) brightness(1.05);
  }
  .sky-block.dim { filter: grayscale(1) brightness(0.42) contrast(0.9); }
  .sky-glow path { fill: var(--accent); opacity: 0.38; }
  .sky-roofs path { stroke: rgb(255 255 255 / 0.75); stroke-width: 1.5px; fill: none; }
  .sky-roofs path.dim { stroke: rgb(255 255 255 / 0.22); }
  .sky-roofs .best path { stroke: var(--accent); stroke-width: 2.5px; }

  .sky-typical { position: absolute; left: 0; right: 0; border-top: 1px dashed rgb(255 255 255 / 0.28); pointer-events: none; z-index: 1; }
  .sky-typical b { position: absolute; right: 0; bottom: 3px; font: 600 10px var(--font-body); letter-spacing: var(--eyebrow-tracking); text-transform: uppercase; color: rgb(238 240 246 / 0.7); padding: 1px 6px; border-radius: 6px; background: rgb(7 8 12 / 0.72); }
  .sky-peak { position: absolute; translate: -50% -125%; font-size: 18px; line-height: 1; color: var(--accent); text-shadow: 0 0 14px rgb(255 211 107 / 0.9); pointer-events: none; z-index: 1; }

  /* Lifting a season: it rises a little and the rest of the city steps back. */
  .sky-block, .sky-roofs g { transition: translate 0.28s var(--ease), opacity 0.28s var(--ease); }
  .sky-block.up { translate: 0 -5%; }
  .sky-roofs g.up { translate: 0 -15px; } /* 5% of the 300-unit sky */
  .sky.lifting :is(.sky-block, .sky-roofs g):not(.up) { opacity: 0.4; }
  .sky.lifting .sky-glow { opacity: 0.4; }

  .sky-seasons { position: absolute; inset: 0; }
  .sky-seasons button {
    position: absolute; top: 0; bottom: 0; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 6px;
    display: flex; align-items: flex-end; justify-content: center; color: var(--muted); font: 600 var(--text-xs) var(--font-body);
  }
  .sky-seasons button span { padding-bottom: 14px; }
  .sky-seasons button span.best { color: var(--accent); }
  .sky-seasons button[aria-pressed="true"] span, .sky-seasons button:hover span { color: var(--text); }
  .sky-seasons button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .sky-say { min-height: 1.5em; margin: var(--space-3) 0 var(--space-6); font: 700 clamp(17px, 3.4vw, 22px) / 1.3 var(--font-display); color: var(--text); }
  .sky-say span { font: 500 var(--text-sm) var(--font-body); color: var(--muted); }

  /* The city rises out of the water, one season after another. */
  .sky:not(.in) :is(.sky-block, .sky-glow) { translate: 0 100%; }
  .sky:not(.in) .sky-roofs g { translate: 0 300px; }
  .sky:not(.in) :is(.sky-peak, .sky-typical) { opacity: 0; }
  .sky.in:not(.done) :is(.sky-block, .sky-roofs g, .sky-glow) { transition: translate 0.55s var(--ease) calc(var(--i, 0) * 45ms); }
  .sky.in:not(.done) :is(.sky-peak, .sky-typical) { transition: opacity 0.3s 0.5s; }

  .sky-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: var(--space-2); margin: 0; }
  @media (min-width: 720px) { .sky-tiles { gap: var(--space-3); } }
  .sky-tiles div { padding: var(--space-3) clamp(10px, 2.5vw, 16px); border-radius: var(--radius-media); background: var(--surface); border: 1px solid var(--line); }
  .sky-tiles dt { font: 600 11px var(--font-body); color: var(--muted); letter-spacing: var(--eyebrow-tracking); text-transform: uppercase; }
  .sky-tiles dd { margin: var(--space-2) 0 0; }
  .sky-tiles b { display: block; font: 800 clamp(19px, 5vw, 34px) / 1.05 var(--font-display); letter-spacing: -0.02em; }
  .sky-tiles span { display: block; margin-top: 6px; font-size: var(--text-xs); color: var(--muted); }
  @media (min-width: 720px) { .sky-tiles span { font-size: var(--text-sm); } }

  @media (prefers-reduced-motion: reduce) {
    .sky * { transition: none !important; }
  }
  @media (forced-colors: active) {
    .sky-block { forced-color-adjust: none; background: CanvasText; }
    .sky-block.dim { background: GrayText; filter: none; }
    .sky-glow, .sky-back { display: none; }
    .sky-roofs { forced-color-adjust: none; }
    .sky-roofs path, .sky-roofs .best path { stroke: Highlight; }
    .sky-typical { border-color: CanvasText; }
  }
</style>
