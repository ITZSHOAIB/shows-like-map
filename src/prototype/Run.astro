---
// PROTOTYPE (payoff-prototype): the run. The whole show as one ridge across the hours it takes, lit where it's good,
// dim where it's warming up or past its best. A bead rides it: drag it and it tells you where you'd be.
import { CEIL, FLOOR, endingWords, hoursLabel, smooth, type Arc } from "./arc";
const { arc, id } = Astro.props as { arc: Arc; id: string };

const W = 1000, H = 260, TOP = 28, BOTTOM = 14;
const x = (h: number) => (h / arc.hours) * W;
const y = (v: number) => TOP + (1 - (Math.min(CEIL, Math.max(FLOOR, v)) - FLOOR) / (CEIL - FLOOR)) * (H - TOP - BOTTOM);
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(2)}%`;

// One smooth stroke per season: chapters, with a breath between them.
const pts = smooth(arc.episodes);
const chapters = arc.seasons
  .map((s) => pts.filter((p) => p.x >= s.start && p.x <= s.end).map((p) => ({ x: x(p.x), y: y(p.y) })))
  .filter((c) => c.length);
const curve = (c: { x: number; y: number }[]) => {
  if (c.length === 1) return `M${c[0].x - 4},${c[0].y}L${c[0].x + 4},${c[0].y}`;
  let d = `M${c[0].x.toFixed(1)},${c[0].y.toFixed(1)}`;
  for (let i = 1; i < c.length; i++) {
    const m = { x: (c[i - 1].x + c[i].x) / 2, y: (c[i - 1].y + c[i].y) / 2 };
    d += `Q${c[i - 1].x.toFixed(1)},${c[i - 1].y.toFixed(1)} ${m.x.toFixed(1)},${m.y.toFixed(1)}`;
  }
  return d + `L${c.at(-1)!.x.toFixed(1)},${c.at(-1)!.y.toFixed(1)}`;
};
const lines = chapters.map(curve);
const fills = chapters.map((c, i) => `${lines[i]}L${c.at(-1)!.x.toFixed(1)},${H}L${c[0].x.toFixed(1)},${H}Z`);

// The lit stretch: from where it gets going to where it fades.
const from = arc.slowStart?.hours ?? 0, to = arc.fadeAfter?.hours ?? arc.hours;
const fx = (from / arc.hours) * 100, tx = (to / arc.hours) * 100;
// The peak: the highest point of the line within its best season.
const top = arc.best && pts.filter((p) => p.x >= arc.best!.start && p.x <= arc.best!.end).reduce((a, p) => (p.y > a.y ? p : a));
const peak = top && { x: x(top.x), y: y(top.y), at: top.x };

// What the bead says at each episode, worked out here so the page only looks it up.
const lastSeason = arc.seasons.at(-1)!;
const say = (h: number, season: number) => {
  if (arc.slowStart && h < arc.slowStart.hours) return `Still warming up. It gets going in ${hoursLabel(arc.slowStart.hours - h)}.`;
  if (arc.fadeAfter && h >= arc.fadeAfter.hours) {
    if (arc.finale === "divides" && season === lastSeason.n) return "The final stretch, and the ending divides viewers.";
    return `Past its best. Stopping at ${hoursLabel(arc.fadeAfter.hours)} is a fine place to finish.`;
  }
  if (arc.best && season === arc.best.n && arc.seasons.length > 1) return "You're in its best season.";
  if (arc.finale === "divides" && season === lastSeason.n && arc.seasons.length > 2) return "The final season, and the ending divides viewers.";
  if (arc.best && arc.seasons.length > 1 && h < arc.best.start) return `Good from here. Its best season starts ${hoursLabel(arc.best.start - h)} later.`;
  if (arc.fadeAfter) return `Still good. It fades in ${hoursLabel(arc.fadeAfter.hours - h)}.`;
  return arc.ending === "ended" && season === lastSeason.n ? `Nearly there: ${endingWords(arc.ending, arc.finale)}.` : "Still good here.";
};
const stops = arc.episodes.flatMap((e) => {
  const p = pts.find((q) => q.x === (e.start + e.end) / 2);
  if (!p) return [];
  return [{
    x: (p.x / arc.hours) * 100,
    y: (y(p.y) / H) * 100,
    tag: `S${e.season} · E${e.number} · ${hoursLabel(e.start)} in`,
    say: say(e.start, e.season),
  }];
});
// Where the bead glides to on arrival: where it gets going, else the peak.
const near = (h: number) => stops.reduce((b, s, i) => (Math.abs(s.x - (h / arc.hours) * 100) < Math.abs(stops[b].x - (h / arc.hours) * 100) ? i : b), 0);
const start = stops.length ? (arc.slowStart ? near(arc.slowStart.hours + 0.01) : peak ? near(peak.at) : 0) : 0;

// The verdict with its key words lit.
const lit = arc.verdict.replace(/\b(great|good|decent|weak|fades|ends on a high|divides viewers|best: season \d+)\b/gi, "<em>$1</em>");
const tiles = [
  arc.slowStart
    ? { k: "Gets good", v: hoursLabel(arc.slowStart.hours), s: arc.slowStart.season ? `in · season ${arc.slowStart.season}` : `in · episode ${arc.slowStart.episode}` }
    : { k: "Gets good", v: "At once", s: "no warming up" },
  arc.best && arc.seasons.length > 1 ? { k: "Peak", v: `Season ${arc.best.n}`, s: arc.best.start < 0.5 ? `the first ${hoursLabel(arc.best.end)}` : `${hoursLabel(arc.best.start)} to ${hoursLabel(arc.best.end)} in` } : null,
  arc.fadeAfter
    ? { k: "Stop at", v: hoursLabel(arc.fadeAfter.hours), s: `after season ${arc.fadeAfter.season}, if you like` }
    : { k: "All of it", v: hoursLabel(arc.hours), s: endingWords(arc.ending, arc.finale) },
].filter(Boolean) as { k: string; v: string; s: string }[];
---

<section class="run" style={`--peak:${peak ? pct(peak.x, W) : "50%"}`} aria-labelledby={`${id}-q`}>
  <p class="run-q eyebrow" id={`${id}-q`}>Is it worth getting through?</p>
  <p class="run-verdict" set:html={lit} />

  <div class="run-stage" data-stops={JSON.stringify(stops)} data-start={start} data-peak={peak ? (peak.x / W) * 100 : -99}>
    <svg class="run-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={`${id}-tone`} gradientUnits="userSpaceOnUse" x1="0" x2={W} y1="0" y2="0">
          <stop offset={`${Math.max(fx - 0.01, 0)}%`} stop-color="var(--run-dim)" />
          <stop offset={`${fx}%`} stop-color="var(--accent)" />
          <stop offset={`${tx}%`} stop-color="var(--accent)" />
          <stop offset={`${Math.min(tx + 0.01, 100)}%`} stop-color="var(--run-dim)" />
        </linearGradient>
        <linearGradient id={`${id}-fall`} x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.5" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <mask id={`${id}-mask`}><rect width={W} height={H} fill={`url(#${id}-fall)`} /></mask>
        <filter id={`${id}-glow`} x="-5%" y="-30%" width="110%" height="160%"><feGaussianBlur stdDeviation="7" /></filter>
      </defs>
      <line class="run-usual" x1="0" x2={W} y1={y(arc.mean)} y2={y(arc.mean)} vector-effect="non-scaling-stroke" />
      <g class="run-fill" mask={`url(#${id}-mask)`}>{fills.map((d) => <path d={d} fill={`url(#${id}-tone)`} />)}</g>
      <g class="run-glow" filter={`url(#${id}-glow)`}>{lines.map((d) => <path d={d} stroke={`url(#${id}-tone)`} />)}</g>
      <g class="run-line">{lines.map((d) => <path d={d} pathLength="1" stroke={`url(#${id}-tone)`} vector-effect="non-scaling-stroke" />)}</g>
    </svg>

    {peak && (
      <span class="run-peak" style={`left:${pct(peak.x, W)};top:${pct(peak.y, H)}`} aria-hidden="true">
        <i></i><b>★ Peak · S{arc.best!.n}</b>
      </span>
    )}
    <span class="run-rule" aria-hidden="true"></span>
    <span class="run-bead" aria-hidden="true"><b class="run-tag"></b></span>
    <input class="run-range" type="range" min="0" max={stops.length - 1} value={start}
      aria-label="Move along the run" aria-valuetext={`${stops[start]?.tag}. ${stops[start]?.say}`} />
  </div>

  <div class="run-axis" aria-hidden="true">
    {arc.seasons.filter((s) => (s.end - s.start) / arc.hours >= 0.06).map((s) => (
      <span class:list={[s === arc.best && "best"]} style={`left:${pct((s.start + s.end) / 2, arc.hours)}`}>S{s.n}</span>
    ))}
  </div>
  <p class="run-say" aria-hidden="true">{stops[start]?.say}</p>

  <dl class="run-tiles">
    {tiles.map((t) => <div><dt>{t.k}</dt><dd><b>{t.v}</b> <span>{t.s}</span></dd></div>)}
  </dl>
</section>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  for (const stage of document.querySelectorAll<HTMLElement>(".run-stage")) {
    const run = stage.closest<HTMLElement>(".run")!;
    const stops: { x: number; y: number; tag: string; say: string }[] = JSON.parse(stage.dataset.stops!);
    const input = stage.querySelector<HTMLInputElement>(".run-range")!;
    const bead = stage.querySelector<HTMLElement>(".run-bead")!, rule = stage.querySelector<HTMLElement>(".run-rule")!;
    const tag = bead.querySelector<HTMLElement>(".run-tag")!, sayEl = run.querySelector<HTMLElement>(".run-say")!;
    const place = (i: number) => {
      const s = stops[i];
      if (!s) return;
      bead.style.left = rule.style.left = `${s.x}%`;
      bead.style.top = `${s.y}%`;
      // The tag stays inside the stage at either end.
      tag.style.translate = `${s.x < 15 ? "-14px" : s.x > 85 ? "calc(-100% + 14px)" : "-50%"} 0`;
      tag.textContent = s.tag;
      if (sayEl.textContent !== s.say) {
        sayEl.textContent = s.say;
        sayEl.animate?.([{ opacity: 0.35 }, { opacity: 1 }], { duration: still.matches ? 0 : 180 });
      }
      run.classList.toggle("at-peak", Math.abs(s.x - +stage.dataset.peak!) < 9);
      input.value = String(i);
      input.setAttribute("aria-valuetext", `${s.tag}. ${s.say}`);
    };
    input.addEventListener("input", () => place(+input.value));

    // Drag anywhere on the stage: the bead follows the nearest episode under the finger or mouse.
    const nearest = (clientX: number) => {
      const b = stage.getBoundingClientRect(), at = ((clientX - b.left) / b.width) * 100;
      let i = 0;
      for (let j = 1; j < stops.length; j++) if (Math.abs(stops[j].x - at) < Math.abs(stops[i].x - at)) i = j;
      return i;
    };
    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      run.classList.add("dragging");
      stage.setPointerCapture(e.pointerId);
      place(nearest(e.clientX));
      input.focus({ preventScroll: true });
      const move = (m: PointerEvent) => place(nearest(m.clientX));
      const up = () => { run.classList.remove("dragging"); stage.removeEventListener("pointermove", move); };
      stage.addEventListener("pointermove", move);
      stage.addEventListener("pointerup", up, { once: true });
      stage.addEventListener("pointercancel", up, { once: true });
    });

    // Arriving: the line draws itself, then the bead glides from the first episode to where it gets good. Once.
    const target = +stage.dataset.start!;
    if (still.matches) { place(target); run.classList.add("in", "done"); continue; }
    place(0);
    new IntersectionObserver((seen, io) => {
      if (!seen.some((s) => s.isIntersecting)) return;
      io.disconnect();
      run.classList.add("in");
      setTimeout(() => { run.classList.add("glide"); place(target); setTimeout(() => run.classList.replace("glide", "done"), 700); }, 750);
    }, { threshold: 0.4 }).observe(stage);
  }
</script>

<style is:global>
  .run {
    --run-dim: #5b6175;
    position: relative; isolation: isolate;
    padding: var(--space-6) 0 var(--space-4);
  }
  /* A warm light rising behind the peak. */
  .run::before {
    content: ""; position: absolute; z-index: -1; inset: 10% -10% 0;
    background: radial-gradient(38% 55% at var(--peak) 55%, rgb(255 211 107 / 0.13), transparent 70%);
    pointer-events: none;
  }
  .run-q { margin: 0 0 var(--space-2); }
  .run-verdict {
    margin: 0 0 var(--space-6); max-width: 22ch;
    font: var(--display-weight) clamp(28px, 6.4vw, 52px) / 1.04 var(--font-display); letter-spacing: -0.03em;
    text-wrap: balance; color: #c9cdd9;
  }
  .run-verdict em { font-style: normal; color: var(--accent); }

  .run-stage { position: relative; height: clamp(180px, 34vw, 280px); touch-action: pan-y; cursor: ew-resize; user-select: none; -webkit-user-select: none; }
  .run-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .run-usual { stroke: rgb(255 255 255 / 0.16); stroke-dasharray: 2 6; }
  .run-line path { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .run-glow path { fill: none; stroke-width: 10; opacity: 0.55; }
  .run-fill path { opacity: 0.4; }

  .run-peak { position: absolute; translate: -50% -50%; pointer-events: none; }
  .run-peak i { display: block; width: 12px; height: 12px; border-radius: 50%; background: #fff6dd; box-shadow: 0 0 0 4px rgb(255 211 107 / 0.25), 0 0 24px 6px rgb(255 211 107 / 0.55); }
  .run.at-peak .run-peak b { opacity: 0; }
  .run-peak b { transition: opacity 0.2s; position: absolute; bottom: 18px; left: 50%; translate: -50% 0; white-space: nowrap; font: 700 var(--text-xs) var(--font-body); color: var(--accent); letter-spacing: 0.02em; }

  .run-rule { position: absolute; top: 0; bottom: 0; width: 1px; translate: -0.5px 0; background: linear-gradient(transparent, rgb(255 255 255 / 0.35) 30%, rgb(255 255 255 / 0.35)); pointer-events: none; opacity: 0; }
  .run-bead {
    position: absolute; width: 18px; height: 18px; translate: -50% -50%; border-radius: 50%; pointer-events: none; opacity: 0;
    background: var(--text); box-shadow: 0 0 0 5px rgb(255 255 255 / 0.14), 0 6px 18px rgb(0 0 0 / 0.6);
  }
  .run-tag {
    position: absolute; bottom: calc(100% + 12px); left: 50%; white-space: nowrap; padding: 5px 9px; border-radius: var(--radius-pill);
    background: rgb(21 24 33 / 0.92); border: 1px solid var(--line); font: 600 var(--text-xs) var(--font-body); color: var(--text); font-variant-numeric: tabular-nums;
    backdrop-filter: blur(6px);
  }
  .run.in .run-bead, .run.in .run-rule { opacity: 1; transition: opacity 0.3s 0.55s; }
  .run.glide :is(.run-bead, .run-rule) { transition: left 0.65s var(--ease), top 0.65s var(--ease), opacity 0.3s; }
  .run.dragging .run-bead { scale: 1.2; }
  .run-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
  .run-stage:has(.run-range:focus-visible) { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 6px; }

  /* The line draws itself left to right, then the light fills in under it. */
  .run-line path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .run-glow, .run-fill, .run-peak { opacity: 0; }
  .run.in .run-line path { animation: run-draw 0.8s var(--ease) forwards; }
  .run.in :is(.run-glow, .run-fill, .run-peak) { animation: run-show 0.5s 0.45s var(--ease) forwards; }
  .run.done .run-line path, .run.done :is(.run-glow, .run-fill, .run-peak) { animation: none; stroke-dashoffset: 0; opacity: 1; }
  @keyframes run-draw { to { stroke-dashoffset: 0; } }
  @keyframes run-show { to { opacity: 1; } }

  .run-axis { position: relative; height: 24px; margin-top: var(--space-2); font: 600 var(--text-xs) var(--font-body); color: var(--muted); }
  .run-axis span { position: absolute; translate: -50% 0; }
  .run-axis .best { color: var(--accent); }
  .run-say { min-height: 1.5em; margin: var(--space-3) 0 var(--space-6); font: 700 clamp(17px, 3.4vw, 22px) / 1.3 var(--font-display); color: var(--text); }

  .run-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: var(--space-2); margin: 0; }
  @media (min-width: 720px) { .run-tiles { gap: var(--space-3); } }
  .run-tiles div { padding: var(--space-3) clamp(10px, 2.5vw, 16px); border-radius: var(--radius-media); background: var(--surface); border: 1px solid var(--line); }
  .run-tiles dt { font: 600 var(--text-xs) var(--font-body); color: var(--muted); letter-spacing: var(--eyebrow-tracking); text-transform: uppercase; }
  .run-tiles dd { margin: var(--space-2) 0 0; }
  .run-tiles b { display: block; font: 800 clamp(19px, 5vw, 34px) / 1.05 var(--font-display); letter-spacing: -0.02em; }
  .run-tiles span { display: block; margin-top: 6px; font-size: var(--text-xs); color: var(--muted); }
  @media (min-width: 720px) { .run-tiles span { font-size: var(--text-sm); } }
  .run-tiles dt { font-size: 11px; }

  @media (prefers-reduced-motion: reduce) {
    .run * { animation: none !important; transition: none !important; }
  }
  @media (forced-colors: active) {
    .run-svg, .run-bead, .run-peak i, .run-rule { forced-color-adjust: none; }
    .run-line path, .run-glow path { stroke: CanvasText; }
    .run-glow, .run-fill, .run::before { display: none; }
    .run-usual { stroke: GrayText; }
    .run-bead { background: Highlight; box-shadow: none; }
    .run-peak i { background: Highlight; box-shadow: none; }
    .run-rule { background: GrayText; }
  }
</style>
