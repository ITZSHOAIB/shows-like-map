---
// The page shell: head tags, the self-hosted display font, and the data credits every page carries.
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { scriptJson, SITE_NAME } from "../lib/seo";

interface Props {
  title: string;
  description?: string | null;
  path: string; // canonical path, with a trailing slash
  image?: string; // the link preview's picture: a path on this site or an absolute URL. Without one, the site's own card
  largeImage?: boolean; // the picture is 1200x630, for the big card; a poster is small, so it gets the compact one
  jsonLd?: unknown; // structured data for the page
}
const { title, description, path, image, largeImage, jsonLd } = Astro.props;
const url = new URL(path, Astro.site);
const picture = new URL(image ?? "/og.png", Astro.site).href;
const large = largeImage || !image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={url} />
    {/* Link previews (Open Graph, and Twitter's card, which other apps read too). */}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    <meta property="og:image" content={picture} />
    <meta name="twitter:card" content={large ? "summary_large_image" : "summary"} />
    {jsonLd !== undefined && <script type="application/ld+json" set:html={scriptJson(jsonLd)} />}
    <link rel="preconnect" href="https://static.tvmaze.com" />
  </head>
  <body>
    <header class="top wrap">
      <a href="/" class="brand"><Icon name="popcorn" /> Shows<span>Like</span>Map</a>
    </header>
    <slot />
    <footer class="foot wrap muted">
      <slot name="credits" />
      <p>Show data from <a href="https://www.tvmaze.com/">TVmaze</a> (CC BY-SA 4.0) and <a href="https://www.wikidata.org/">Wikidata</a> (CC0).</p>
    </footer>
  </body>
</html>

<style>
  .top { position: relative; z-index: 1; display: flex; align-items: center; height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 6px; font: var(--display-weight) var(--text-lg) var(--font-display); letter-spacing: var(--display-tracking); text-transform: var(--display-case); }
  .brand :global(.icon) { color: var(--accent); width: 24px; height: 24px; }
  .brand span { color: var(--accent); }
  .foot { padding-top: var(--space-8); padding-bottom: var(--space-8); font-size: var(--text-xs); }
  .foot :global(p) { margin: var(--space-1) 0; }
  .foot :global(a) { text-decoration: underline; text-underline-offset: 2px; }
</style>
