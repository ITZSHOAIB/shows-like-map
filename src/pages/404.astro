---
// Cloudflare Pages serves 404.html with a 404 status; without it, unknown URLs got the home page with a 200.
// It wears the site's own header, type and footer, so a wrong link still feels like the same place.
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Shows Like Map" noindex>
  <main class="wrap lost">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="muted">This show isn't on the map, or the link is wrong.</p>
    <a class="pill back" href="/"><Icon name="magnifying-glass" /> Find a show</a>
  </main>
</Base>

<style>
  .lost { padding-top: var(--space-6); padding-bottom: var(--space-4); }
  h1 { font-size: var(--text-xl); line-height: 1.02; margin: var(--space-1) 0 var(--space-2); }
  .lost .muted { margin: 0 0 var(--space-6); }
  .back { min-height: 40px; padding: 0 var(--space-4); gap: var(--space-2); }
  .back:hover { border-color: var(--accent); }
  .back :global(.icon) { color: var(--accent); }
</style>
