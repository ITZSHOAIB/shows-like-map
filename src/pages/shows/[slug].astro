---
// The show page, "Drill down" (decision 0005), first slice of #3: the hero and rows of matches, static, no JavaScript.
import Icon from "../../components/Icon.astro";
import MatchCard from "../../components/MatchCard.astro";
import Base from "../../layouts/Base.astro";
import { hours, loadCatalogue, STATUS_LABEL, type Show, type Status } from "../../lib/catalogue";
import { filterAttrs, HOUR_LIMITS } from "../../lib/filters";
import { loadMatches, type Match } from "../../lib/matches";

export function getStaticPaths() {
  const catalogue = loadCatalogue();
  const byId = new Map(catalogue.map((s) => [s.id, s]));
  // A match links to its own page when it has one; matches outside the catalogue show unlinked (decision in #2).
  const matches = loadMatches();
  return catalogue.map((show) => ({
    params: { slug: show.slug },
    props: { show, matches: (matches.get(show.id) ?? []).map((m) => ({ match: m, show: byId.get(m.id) })) },
  }));
}

const { show, matches } = Astro.props as { show: Show; matches: { match: Match; show?: Show }[] };
const year = show.premiered?.slice(0, 4);
const STATUS_ICON: Record<Status, string> = {
  running: "broadcast",
  ended: "check-circle",
  cancelled: "x-circle",
  uncertain: "question",
  upcoming: "calendar-dots",
};
const linked = matches.some((m) => m.show);
const description = `Shows like ${show.name}, each with why it's similar, whether it ended, and how many hours it takes to finish.`;
---

<Base title={`Shows like ${show.name} | Shows Like Map`} {description} path={`/shows/${show.slug}/`}>
  <main>
    <section class="hero">
      {/* The poster, blurred and faded, as the backdrop: no extra download, and every show has one (TVmaze backgrounds are 0.5 MB originals). */}
      {show.poster && <img class="backdrop" src={show.poster} alt="" aria-hidden="true" />}
      {/* "Your path": the shows this tab went through, built before first paint from sessionStorage, so the show you came
          from can morph into its chip. Hidden until there are two. */}
      <nav class="trail wrap" id="trail" aria-label="Your path" hidden></nav>
      <script is:inline define:vars={{ here: { slug: show.slug, name: show.name, poster: show.poster } }}>
        function drawPath() {
          let path = [];
          try { path = JSON.parse(sessionStorage.getItem("slm:path") || "[]"); } catch {}
          const at = path.findIndex((s) => s.slug === here.slug);
          const arrived = at < 0; // a step deeper, not back along the path
          path = arrived ? [...path, here].slice(-12) : path.slice(0, at + 1);
          try { sessionStorage.setItem("slm:path", JSON.stringify(path)); } catch {}

          const nav = document.getElementById("trail");
          nav.hidden = path.length < 2;
          const label = document.createElement("span");
          label.className = "trail-label";
          label.ariaHidden = "true";
          label.textContent = "Your path";
          const list = document.createElement("ol");
          path.forEach((s, i) => {
            const current = i === path.length - 1;
            const chip = document.createElement(current ? "span" : "a");
            chip.className = "pill chip";
            if (current) chip.setAttribute("aria-current", "page");
            else chip.href = `/shows/${s.slug}/`;
            let morph = chip;
            if (s.poster) {
              morph = Object.assign(new Image(20, 30), { src: s.poster, alt: "" });
              chip.append(morph);
            }
            if (arrived && i === path.length - 2) morph.style.viewTransitionName = "prev-hero";
            const name = document.createElement("span");
            name.textContent = s.name;
            chip.append(name);
            const item = document.createElement("li");
            item.append(chip);
            list.append(item);
          });
          nav.replaceChildren(label, list);
          nav.scrollLeft = nav.scrollWidth;
        }
        drawPath();
        // A page restored by Back keeps its old strip; trim the stored path to it so the next step continues from here.
        addEventListener("pageshow", (e) => e.persisted && drawPath());
      </script>
      <div class="hero-in wrap">
      {
        show.poster ? (
          <img class="poster h-poster" src={show.poster} alt={`${show.name} poster`} width="210" height="295" fetchpriority="high" />
        ) : (
          <span class="poster-ph h-poster" aria-hidden="true">{show.name}</span>
        )
      }
      <div class="h-text">
        <p class="eyebrow">If you liked</p>
        <h1>{show.name}</h1>
        <ul class="facts">
          <li class={`pill badge s-${show.status}`}><Icon name={STATUS_ICON[show.status]} /> {STATUS_LABEL[show.status]}</li>
          {show.minutes !== null && <li class="pill"><Icon name="hourglass-medium" /> {hours(show.minutes)} to finish</li>}
          {show.platform && <li class="pill"><Icon name="television" /> {show.platform}</li>}
          {year && <li class="pill"><Icon name="calendar-dots" /> {year}</li>}
        </ul>
        <p class="muted small">
          {show.seasons} {show.seasons === 1 ? "season" : "seasons"} · {show.episodes} episodes{show.language && <> · {show.language}</>}
        </p>
      </div>
      {/* Three lines of summary keep the matches near the top; the toggle opens the rest and the people. The text sits
          outside <summary> so screen readers hear a short button, not the whole summary. */}
      {
        (show.summary || show.creators.length > 0 || show.cast.length > 0) && (
          <div class="about">
            {show.summary && <p class="summary">{show.summary}</p>}
            <details>
              <summary class="toggle">
                <span class="more">More</span><span class="less">Less</span><span class="sr-only"> about {show.name}</span>
                <Icon name="caret-down" />
              </summary>
              <dl class="people small">
                {show.creators.length > 0 && <><dt>Created by</dt><dd>{show.creators.join(", ")}</dd></>}
                {show.cast.length > 0 && <><dt>Starring</dt><dd>{show.cast.join(", ")}</dd></>}
              </dl>
            </details>
          </div>
        )
      }
      </div>
    </section>

    {
      matches.length > 0 ? (
        <div class="rows">
          <section class="row">
            <h2 class="wrap"><Icon name="sparkle" /> <span id="matches-title">Shows like {show.name}</span> <small class="muted" id="matches-count"></small></h2>
            {/* Filters work without JavaScript: CSS hides the cards that don't pass, from each card's data attributes.
                JavaScript adds the count, remembers the choice for the next show, and announces changes. Only shown
                when some match has the details to filter on. */}
            {linked && (<>
              <form class="filters wrap" id="filters" aria-label="Filter shows" autocomplete="off">
                <label class="pill f-chip"><input type="checkbox" name="finished" id="f-fin" /><Icon name="check-circle" /> Finished</label>
                {/* The phone's own picker for hours: a bottom sheet on Android, a wheel on iPhone. Each option has an
                    id, so CSS can see which is chosen (#f-h20:checked) as it did with radios. */}
                <span class="pill f-chip f-pick">
                  <Icon name="hourglass-medium" />
                  <label class="sr-only" for="f-hours">Hours to finish</label>
                  <select name="hours" id="f-hours">
                    <option value="0" selected>Any length</option>
                    {HOUR_LIMITS.map((h) => <option value={h} id={`f-h${h}`}>Under {h} hours</option>)}
                  </select>
                  <Icon name="caret-down" />
                </span>
                <button type="reset" class="f-clear">Clear</button>
              </form>
              {/* Before the cards are parsed, so a saved filter never flashes the whole row first. */}
              <script is:inline define:vars={{ limits: HOUR_LIMITS }}>
                function restoreFilters() {
                  const form = document.getElementById("filters");
                  let saved = {};
                  try { saved = JSON.parse(localStorage.getItem("slm:filters") || "{}"); } catch {}
                  form.finished.checked = saved.finished === true;
                  form.hours.value = limits.includes(saved.hours) ? String(saved.hours) : "0";
                }
                restoreFilters();
                // A page restored by Back shows the filters it was left with; bring it up to date.
                addEventListener("pageshow", (e) => e.persisted && restoreFilters());
              </script>
              <p class="empty wrap">
                None match your filters.
                <button type="reset" form="filters" class="pill f-chip">Clear filters</button>
              </p>
            </>)}
            {/* role="list" because Safari drops list semantics under list-style: none. With no links to tab through,
                the track itself takes focus so keyboard users can still scroll it. */}
            <ul class="track" role="list" aria-labelledby="matches-title" tabindex={linked ? undefined : 0}>
              {matches.map((m, i) => <li {...filterAttrs(m.show)}><MatchCard match={m.match} show={m.show} eager={i < 3} /></li>)}
            </ul>
            {linked && <p class="sr-only" id="filters-status" aria-live="polite"></p>}
          </section>
        </div>
      ) : (
        <p class="wrap muted">No matches for this show yet.</p>
      )
    }
  </main>
  {/* The next show starts loading when a finger touches its card (on desktop, a short hover), and Chrome hands the
      download in flight to the navigation, so a tap shows the next page in under 300 ms (decision 0005). */}
  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prefetch: [{ source: "document", where: { selector_matches: "a.card, .trail a" }, eagerness: "moderate" }],
  })} />
  <script>
    // The tapped poster takes the next hero's name and this hero shrinks into the next page's newest path chip.
    // Going back along the path, the chip grows into the hero instead.
    document.addEventListener("click", (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>("a.card, .trail a");
      if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      document.querySelectorAll<HTMLElement>("[style*='view-transition-name']").forEach((el) => (el.style.viewTransitionName = ""));
      const hero = document.querySelector<HTMLElement>(".h-poster");
      if (hero) hero.style.viewTransitionName = link.matches(".trail a") ? "none" : "prev-hero";
      const poster = link.querySelector<HTMLElement>("img, .poster-ph") ?? link;
      poster.style.viewTransitionName = "hero-poster";
    });
    // Back and Forward skip the morph: names are set for going deeper, so they'd pair the wrong posters.
    addEventListener("pageswap", (e) => {
      if (e.activation?.navigationType === "traverse") e.viewTransition?.skipTransition();
    });

    // Filters: CSS does the hiding. This counts what's left, saves the choice for the next show, and announces it.
    const form = document.querySelector<HTMLFormElement>("#filters");
    if (form) {
      const items = [...document.querySelectorAll<HTMLElement>(".track li")];
      const count = document.getElementById("matches-count")!;
      const status = document.getElementById("filters-status")!;
      const update = (announce: boolean) => {
        const finished = (form.elements.namedItem("finished") as HTMLInputElement).checked;
        const hours = (form.elements.namedItem("hours") as HTMLSelectElement).value;
        const on = finished || hours !== "0";
        const shown = items.filter((li) => (!finished || "fin" in li.dataset) && (hours === "0" || `h${hours}` in li.dataset)).length;
        count.textContent = on ? `· ${shown} of ${items.length}` : "";
        if (!announce) return;
        status.textContent = !on ? `Showing all ${items.length}` : shown ? `Showing ${shown} of ${items.length}` : "None match your filters";
        try { localStorage.setItem("slm:filters", JSON.stringify({ finished, hours: Number(hours) })); } catch {}
      };
      form.addEventListener("change", () => update(true));
      // "reset" fires before the form resets. Both Clear buttons hide themselves, so focus moves to the first filter.
      form.addEventListener("reset", () => {
        const fromClear = document.activeElement?.matches(".empty button, .f-clear");
        setTimeout(() => {
          if (fromClear) form.querySelector("input")!.focus();
          update(true);
        });
      });
      addEventListener("pageshow", (e) => e.persisted && update(false));
      update(false);
    }
  </script>
  <Fragment slot="credits">
    <p>
      About {show.name}: <a href={show.tvmaze}>TVmaze</a>{show.wikidata && <>, <a href={`https://www.wikidata.org/wiki/${show.wikidata}`}>Wikidata</a></>}{show.wikipedia && <>, <a href={show.wikipedia}>Wikipedia</a></>}.
    </p>
  </Fragment>
</Base>

<style>
  .small { font-size: var(--text-sm); }
  .hero { position: relative; isolation: isolate; overflow: hidden; margin-top: -56px; padding-top: 64px; }
  .backdrop {
    position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover;
    /* Darkened so white posters don't wash out the text; faded out well before the hero ends so there's no edge. */
    filter: blur(28px) saturate(1.3) brightness(0.55); opacity: 0.55; transform: scale(1.3);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 85%);
  }
  /* Forced colours (Windows High Contrast) recolour text but not images, so the blurred poster would sit behind it. */
  @media (forced-colors: active) { .backdrop { display: none; } }
  .h-poster { box-shadow: var(--shadow-2); view-transition-name: hero-poster; }
  .hero-in {
    display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: var(--space-3) var(--space-4); align-items: end;
    padding-top: var(--space-2); padding-bottom: var(--space-6);
  }
  @media (min-width: 720px) { .hero-in { grid-template-columns: 210px minmax(0, 1fr); gap: var(--space-4) var(--space-8); } }

  .trail {
    display: flex; align-items: center; gap: var(--space-2); overflow-x: auto; scrollbar-width: none;
    padding-top: 6px; padding-bottom: 6px;
    scroll-padding-inline: var(--gutter); /* a chip focused by keyboard scrolls fully into view, ring included */
  }
  .trail::-webkit-scrollbar { display: none; }
  .trail[hidden] { display: none; }
  .trail :global(.trail-label) { flex: none; font: 700 var(--text-xs)/1 var(--font-label); text-transform: uppercase; letter-spacing: var(--eyebrow-tracking); }
  .trail :global(ol) { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .trail :global(li) { display: flex; align-items: center; flex: none; }
  .trail :global(li + li)::before { content: ""; width: var(--space-3); height: 2px; background: var(--line); }
  .trail :global(.chip) { max-width: 150px; padding-left: 2px; font-weight: 500; }
  .trail :global(.chip span) { overflow: hidden; text-overflow: ellipsis; }
  .trail :global(.chip img) { width: 20px; height: 30px; flex: none; border-radius: 4px; object-fit: cover; }
  .trail :global(a.chip:hover) { border-color: var(--accent); }
  .trail :global(.chip[aria-current]) { border-color: color-mix(in srgb, var(--accent) 60%, transparent); font-weight: 700; }
  .eyebrow { margin-bottom: var(--space-1); }
  h1 { font-size: var(--text-xl); line-height: 1.02; }
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: var(--space-3) 0 var(--space-2); padding: 0; }
  .h-text { min-width: 0; overflow-wrap: anywhere; }
  .h-text .muted { margin: 0; }
  .about { grid-column: 1 / -1; min-width: 0; max-width: 65ch; }
  @media (min-width: 720px) { .about { grid-column: 2; } }
  .summary { margin: 0; }
  .toggle { list-style: none; cursor: pointer; }
  .toggle::-webkit-details-marker { display: none; }
  /* Closed: three lines fading out. Open: the full text slides down (height: auto animates where interpolate-size is
     supported, and simply snaps open elsewhere), then the people fade in. */
  .about { interpolate-size: allow-keywords; }
  .summary {
    display: block; height: calc(3 * 1.45em); overflow: hidden; transition: height var(--slow) var(--ease);
    mask-image: linear-gradient(to bottom, #000 45%, transparent);
  }
  .about:has(details[open]) .summary { height: auto; mask-image: none; }
  /* At least 24px tall, the WCAG 2.2 minimum target. */
  .toggle {
    display: inline-flex; align-items: center; gap: var(--space-1); min-height: var(--pill-height); padding-right: var(--space-1);
    color: var(--accent); font: var(--label-weight) var(--text-sm) var(--font-label);
  }
  .toggle :global(.icon) { transition: rotate var(--slow); }
  details[open] .toggle :global(.icon) { rotate: 180deg; }
  .less, details[open] .more { display: none; }
  details[open] .less { display: inline; }
  details[open] .people { animation: fade-in var(--slow) 0.1s both; }
  @keyframes fade-in { from { opacity: 0; translate: 0 -4px; } }
  .people { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 2px var(--space-3); margin: 6px 0 0; }
  .people dt { color: var(--muted); }
  .people dd { margin: 0; }

  .rows { display: grid; gap: var(--space-8); }
  .row { min-width: 0; } /* a grid item grows to fit its track of cards otherwise, widening the page */
  .row h2 { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-1) var(--space-2); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .row h2 :global(.icon) { color: var(--accent); align-self: center; }
  .row h2 small { font: 500 var(--text-sm) var(--font-body); letter-spacing: 0; text-transform: none; font-variant-numeric: tabular-nums; }
  /* Filters: a row of chips, as in the filter bars of phone apps. Off is an outline; on is solid gold with dark text,
     so the state shows in fill and weight, not colour alone. 32px tall, over the 24px WCAG 2.2 minimum. */
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-bottom: var(--space-1); }
  .f-chip { min-height: 32px; font-weight: 500; cursor: pointer; }
  .f-chip :global(.icon) { color: var(--muted); }
  /* The checkbox covers its chip, invisible, so it takes the tap and the keyboard focus; the chip shows the ring. */
  .f-chip input { appearance: none; position: absolute; inset: 0; margin: 0; border-radius: inherit; cursor: pointer; }
  .f-chip :is(input, select):focus-visible { outline: none; }
  .f-chip:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .f-chip:is(:has(input:checked), :has(option[id]:checked)) {
    border-color: var(--accent); background: var(--accent); color: #17130a; font-weight: 700;
  }
  .f-chip:is(:has(input:checked), :has(option[id]:checked)) :global(.icon) { color: #17130a; }
  /* Hours: the native select is the chip, with the hourglass and caret drawn over it, so the phone's own picker opens. */
  .f-pick { padding: 0; }
  .f-pick select {
    appearance: none; min-height: 32px; padding: 0 30px 0 32px; border: 0; border-radius: inherit; background: none;
    color: inherit; font: inherit; cursor: pointer;
  }
  .f-pick option { background: var(--bg); color: var(--text); font-weight: 500; }
  .f-pick > :global(.icon) { position: absolute; pointer-events: none; }
  .f-pick > :global(.icon:first-child) { left: var(--space-3); }
  .f-pick > :global(.icon:last-child) { right: 10px; width: 14px; height: 14px; }
  /* Clear, only while a filter is on. */
  .f-clear {
    display: none; min-height: 32px; padding: 0 var(--space-2); border: 0; background: none; color: var(--accent);
    font: 600 var(--text-sm) var(--font-label); cursor: pointer;
  }
  .filters:has(#f-fin:checked, option[id]:checked) .f-clear { display: inline-flex; align-items: center; }
  .f-clear:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Forced colours drop the fill, so "on" chips take the system highlight. That keeps their own colours, ring included,
     so the ring takes the system text colour: the accent would vanish on a light high-contrast theme. */
  @media (forced-colors: active) {
    .f-chip:is(:has(input:checked), :has(option[id]:checked)) { forced-color-adjust: none; background: Highlight; color: HighlightText; border-color: Highlight; }
    .f-chip:is(:has(input:checked), :has(option[id]:checked)) :global(.icon) { color: HighlightText; }
    .f-chip:has(:focus-visible) { outline-color: CanvasText; }
  }

  /* Cards hide when they don't pass a filter that's on (attributes from src/lib/filters.ts, one rule per hour limit). */
  .row:has(#f-fin:checked) .track li:not([data-fin]),
  .row:has(#f-h20:checked) .track li:not([data-h20]),
  .row:has(#f-h40:checked) .track li:not([data-h40]),
  .row:has(#f-h80:checked) .track li:not([data-h80]) { display: none; }
  /* A row with no card passing every filter that's on swaps its track for "None match" and a Clear button. */
  .row:has(#f-fin:checked):not(:has(li[data-fin])),
  .row:has(#f-h20:checked):not(:has(li[data-h20])),
  .row:has(#f-h40:checked):not(:has(li[data-h40])),
  .row:has(#f-h80:checked):not(:has(li[data-h80])),
  .row:has(#f-fin:checked):has(#f-h20:checked):not(:has(li[data-fin][data-h20])),
  .row:has(#f-fin:checked):has(#f-h40:checked):not(:has(li[data-fin][data-h40])),
  .row:has(#f-fin:checked):has(#f-h80:checked):not(:has(li[data-fin][data-h80])) { --track: none; --empty: flex; }
  .empty {
    display: var(--empty, none); align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-3); min-height: 120px;
    margin: 0; color: var(--muted);
  }

  .track {
    display: var(--track, flex); gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    list-style: none; margin: 0;
    /* 10px on top leaves room for the focused card's ring, which the scroller would otherwise clip. */
    padding: 10px max(var(--gutter), calc((100% - 1100px) / 2 + var(--gutter))) var(--space-2);
    scroll-padding-inline: max(var(--gutter), calc((100% - 1100px) / 2 + var(--gutter)));
  }
  .track::-webkit-scrollbar { display: none; }
  .track li { flex: none; display: flex; scroll-snap-align: start; }
  .track:focus-visible { outline-offset: -2px; }
</style>
