---
// Bare show page (catalogue tracer): the commitment facts and the TVmaze credit. The Drill down design comes in #3.
import { hours, loadCatalogue, STATUS_LABEL, type Show } from "../../lib/catalogue";
import { loadMatches, type Match } from "../../lib/matches";

export function getStaticPaths() {
  const catalogue = loadCatalogue();
  const slugs = new Map(catalogue.map((s) => [s.id, s.slug]));
  // A match links to its own page when it has one; matches outside the catalogue show unlinked (decision in #2).
  const matches = loadMatches();
  return catalogue.map((show) => ({
    params: { slug: show.slug },
    props: { show, matches: (matches.get(show.id) ?? []).map((m) => ({ ...m, slug: slugs.get(m.id) })) },
  }));
}

const { show, matches } = Astro.props as { show: Show; matches: (Match & { slug?: string })[] };
const year = show.premiered?.slice(0, 4);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Shows like {show.name} | Shows Like Map</title>
    <link rel="canonical" href={new URL(`/shows/${show.slug}/`, Astro.site)} />
    {show.summary && <meta name="description" content={show.summary} />}
  </head>
  <body>
    <main>
      {show.poster && <img src={show.poster} alt={`${show.name} poster`} width="210" height="295" />}
      <h1>{show.name}{year && <span> ({year})</span>}</h1>
      <dl>
        <dt>Status</dt>
        <dd>{STATUS_LABEL[show.status]}</dd>
        <dt>To finish</dt>
        <dd>{hours(show.minutes)} · {show.episodes} episodes · {show.seasons} {show.seasons === 1 ? "season" : "seasons"}</dd>
        {show.platform && <dt>On</dt>}
        {show.platform && <dd>{show.platform}</dd>}
        {show.language && <dt>Language</dt>}
        {show.language && <dd>{show.language}</dd>}
        {show.creators.length > 0 && <dt>Created by</dt>}
        {show.creators.length > 0 && <dd>{show.creators.join(", ")}</dd>}
        {show.cast.length > 0 && <dt>Starring</dt>}
        {show.cast.length > 0 && <dd>{show.cast.join(", ")}</dd>}
      </dl>
      {show.summary && <p>{show.summary}</p>}
      {
        matches.length > 0 && (
          <section>
            <h2>Shows like {show.name}</h2>
            <ol>
              {matches.map((m) => (
                <li>
                  {m.slug ? <a href={`/shows/${m.slug}/`}>{m.name}</a> : <span>{m.name}</span>}
                  {m.year && <span> ({m.year})</span>}
                  <p>{m.why}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </main>
    <footer>
      <p>
        Show data from <a href={show.tvmaze}>TVmaze</a> (CC BY-SA 4.0) and
        <a href={show.wikidata ? `https://www.wikidata.org/wiki/${show.wikidata}` : "https://www.wikidata.org/"}>Wikidata</a>.
        {show.wikipedia && <a href={show.wikipedia}>Read more on Wikipedia</a>}
      </p>
    </footer>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 40rem;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  img {
    border-radius: 0.5rem;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  li p {
    margin: 0 0 0.75rem;
    color: #555;
  }
</style>
