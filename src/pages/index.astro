---
// The home page (#4, decision 0008): tap a show you loved on the wall, or search for it, with the time you have as
// chips. The chips are the show page's filters (slm:filters), so whatever you open lists matches that fit your time.
// Without JavaScript the wall still works; the search and the chips need it, so they stay hidden.
import Icon from "../components/Icon.astro";
import Tile from "../components/Tile.astro";
import Base from "../layouts/Base.astro";
import { loadCatalogue, STATUS_LABEL } from "../lib/catalogue";
import { HOUR_LIMITS } from "../lib/filters";
import { picksIn, rowsOf, wallOf } from "../lib/home";

const catalogue = loadCatalogue();
const wall = wallOf(catalogue);
const rows = rowsOf(catalogue);
// The hero's backdrop: the first picks, which the wall loads anyway.
const collage = picksIn(catalogue).filter((s) => s.poster).slice(0, 8);
---

<Base
  title="Shows Like Map: find your next show, one you'll actually finish"
  description="Loved a show? Find similar ones, with why each is similar, whether it ended, and how many hours it takes to finish."
  path="/"
  image="/og.png"
  largeImage
>
  <main id="home">
    <section class="hero">
      <div class="collage" aria-hidden="true">
        {collage.map((s) => <img src={s.poster} alt="" width="210" height="295" />)}
      </div>
      <div class="hero-in wrap">
        <p class="eyebrow">Shows like the ones you loved</p>
        <h1>Find your next show, <span>one you'll actually finish.</span></h1>
        <ul class="promise" role="list">
          <li class="pill"><Icon name="sparkle" /> Why each is like it</li>
          <li class="pill"><Icon name="hourglass-medium" /> Hours to finish</li>
          <li class="pill"><Icon name="check-circle" /> Ended or ongoing</li>
        </ul>
      </div>
    </section>

    {/* The finder sticks to the top: the search for a show not on the wall, and the time you have. */}
    <div class="finder" id="finder" hidden>
      <div class="wrap finder-in">
        <form class="search" id="search" role="search" autocomplete="off">
          <label for="q" class="sr-only">Search for a show you loved</label>
          <Icon name="magnifying-glass" />
          <input id="q" name="q" type="search" placeholder="Search a show you loved" enterkeyhint="go" spellcheck="false" />
        </form>
        {/* The show page's filter chips: Finished, then each hour limit; tapping the chosen one again turns it off. */}
        <form class="time" id="time" aria-label="Time for your next show" autocomplete="off">
          <label class="pill f-chip"><input type="checkbox" name="finished" /><Icon name="check-circle" /> Finished</label>
          <div class="f-hours" role="radiogroup" aria-label="Hours to finish">
            <span class="f-under" aria-hidden="true"><Icon name="hourglass-medium" /> Under</span>
            {HOUR_LIMITS.map((h) => (
              <label class="pill f-chip"><input type="radio" name="hours" value={h} id={`f-h${h}`} /><span class="sr-only">Under </span>{h} h</label>
            ))}
          </div>
        </form>
        {/* One line says what's going on: a hint, what your time does, or how many shows the search found. */}
        <p class="note">
          <span id="note" role="status">Set your time, and every show you open lists only matches that fit it.</span>
          <button type="reset" form="time" class="f-clear">Clear</button>
        </p>
      </div>
    </div>
    {/* Before the rows and the wall are parsed, so saved chips never flash the page without their row. */}
    <script is:inline define:vars={{ limits: HOUR_LIMITS }}>
      function restoreTime() {
        const form = document.getElementById("time");
        let saved = {};
        try { saved = JSON.parse(sessionStorage.getItem("slm:filters") || "{}"); } catch {}
        form.finished.checked = saved.finished === true;
        for (const r of form.hours) r.checked = limits.includes(saved.hours) && r.value === String(saved.hours);
      }
      document.getElementById("finder").hidden = false;
      restoreTime();
      // A page restored by Back shows the chips it was left with, which a show page may have changed since.
      addEventListener("pageshow", (e) => e.persisted && restoreTime());
    </script>

    <ul class="tiles results wrap" id="results" role="list" aria-label="Search results" data-labels={JSON.stringify(STATUS_LABEL)}></ul>

    {/* With an hour limit chosen: finished shows under it, to start one straight away. */}
    {
      HOUR_LIMITS.map((h) => (
        <section class="fit" data-h={h} aria-labelledby={`fit-${h}`}>
          <h2 class="wrap" id={`fit-${h}`}><Icon name="hourglass-medium" /> Finished, and under {h} h</h2>
          <ul class="track" role="list">
            {rows[h].map((s) => <li><Tile show={s} /></li>)}
          </ul>
        </section>
      ))
    }

    <section class="wall" aria-labelledby="wall-title">
      <div class="wrap wall-head">
        <h2 id="wall-title"><span class="w-or">Or tap</span><span class="w-tap">Tap</span> one you loved</h2>
        <p class="muted">Its page lists shows like it, why, and how long each takes to finish.</p>
      </div>
      <ul class="tiles wrap" role="list">
        {wall.map((s, i) => <li><Tile show={s} eager={i < 6} /></li>)}
      </ul>
    </section>
  </main>

  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prefetch: [{ source: "document", where: { selector_matches: "a.tile" }, eagerness: "moderate" }],
  })} />
  <script>
    import { POSTERS, prepare, search, type Entry, type Searchable } from "../lib/search";

    const LIMIT = 18;
    const home = document.getElementById("home")!;
    const finder = document.getElementById("finder")!;
    const input = document.getElementById("q") as HTMLInputElement;
    const results = document.getElementById("results")!;
    const note = document.getElementById("note")!;
    const time = document.getElementById("time") as HTMLFormElement;
    const labels: Record<string, string> = JSON.parse(results.dataset.labels!);
    const hint = note.textContent;

    // The index of every show loads the first time someone reaches for the search box.
    let index: Promise<Searchable[]> | undefined;
    const load = () =>
      (index ??= fetch("/search.json")
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then(prepare)
        .catch((err) => {
          index = undefined; // try again on the next keystroke
          throw err;
        }));
    input.addEventListener("focus", () => load().catch(() => {}));

    /** A result, built as Tile.astro builds a show on the wall. */
    function tile([slug, name, year, status, hours, poster]: Entry) {
      const a = document.createElement("a");
      a.className = "tile";
      a.href = `/shows/${slug}/`;
      if (poster) a.append(Object.assign(new Image(210, 295), { className: "poster", src: POSTERS + poster, alt: "", decoding: "async" }));
      else a.append(Object.assign(document.createElement("span"), { className: "poster-ph", ariaHidden: "true", textContent: name }));
      const meta = Object.assign(document.createElement("span"), { className: `t-meta s-${status}` });
      if (year) meta.append(Object.assign(document.createElement("span"), { className: "t-year", textContent: year }));
      meta.append(Object.assign(document.createElement("span"), { className: "dot" }), labels[status], hours ? ` · ${hours}` : "");
      a.append(Object.assign(document.createElement("b"), { className: "t-name", textContent: name }), meta);
      const li = document.createElement("li");
      li.append(a);
      return li;
    }

    const chosen = () => {
      const f = new FormData(time);
      return { finished: f.get("finished") === "on", hours: Number(f.get("hours") ?? 0) };
    };

    let found: Entry[] | null = null; // null: nothing typed
    function describe(failed = false) {
      const typed = input.value.trim();
      if (failed) note.textContent = "Search didn't load. Check your connection, or tap one below.";
      else if (typed && found)
        note.textContent =
          found.length === LIMIT ? `The ${LIMIT} closest shows`
          : found.length ? `${found.length} ${found.length === 1 ? "show" : "shows"} found`
          : `No show called “${typed}” yet. Tap one you loved below.`;
      else {
        const { finished, hours } = chosen();
        const what = [finished && "finished", hours && `under ${hours} h`].filter(Boolean).join(" and ");
        note.textContent = what ? `Every show you open lists matches that are ${what}.` : hint;
      }
    }

    async function find() {
      const typed = input.value;
      if (!typed.trim()) {
        found = null;
        results.replaceChildren();
        home.classList.remove("typing");
        return describe();
      }
      let all: Searchable[];
      try {
        all = await load();
      } catch {
        return describe(true);
      }
      if (input.value !== typed) return; // a newer keystroke is on its way
      found = search(all, typed, LIMIT);
      results.replaceChildren(...found.map(tile));
      // Results take the wall's place; with none, the wall stays to tap from.
      const was = home.classList.contains("typing");
      home.classList.toggle("typing", found.length > 0);
      // On a phone the keyboard takes half the screen: bring the finder to the top so the results show above it.
      if (found.length && !was && finder.getBoundingClientRect().top > 1)
        scrollTo({ top: scrollY + finder.getBoundingClientRect().top, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
      describe();
    }
    input.addEventListener("input", find);
    input.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      input.value = "";
      find();
    });
    // Enter opens the best match.
    document.getElementById("search")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      await find();
      results.querySelector("a")?.click();
    });

    // The time chips save on every change, so the next show page opens with them, as its own filters do.
    const save = () => {
      try { sessionStorage.setItem("slm:filters", JSON.stringify(chosen())); } catch {}
    };
    time.addEventListener("change", () => {
      save();
      describe();
    });
    // Tapping the chosen hours again turns it off, as on the show page; keyboard users have Clear.
    let wasOn = false;
    time.addEventListener("pointerdown", (e) => (wasOn = (e.target as Element).matches("[name=hours]:checked")));
    time.addEventListener("click", (e) => {
      const radio = e.target as HTMLInputElement;
      if (wasOn && radio.name === "hours") {
        radio.checked = false;
        time.dispatchEvent(new Event("change"));
      }
      wasOn = false;
    });
    // "reset" fires before the form resets. Clear hides itself, so focus moves to the first chip.
    time.addEventListener("reset", () => {
      const fromClear = document.activeElement?.matches(".f-clear");
      setTimeout(() => {
        if (fromClear) time.querySelector("input")!.focus();
        save();
        describe();
      });
    });
    // Back to a page kept in memory: the chips were restored before this runs; the words and results catch up.
    addEventListener("pageshow", (e) => e.persisted && find());
    describe();

    // The tapped poster grows into the show page's hero, as a match card's does.
    document.addEventListener("click", (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>("a.tile");
      if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      document.querySelectorAll<HTMLElement>("[style*='view-transition-name']").forEach((el) => (el.style.viewTransitionName = ""));
      link.querySelector<HTMLElement>(".poster, .poster-ph")!.style.viewTransitionName = "hero-poster";
    });
    addEventListener("pageswap", (e) => {
      if ((e as PageSwapEvent).activation?.navigationType === "traverse") (e as PageSwapEvent).viewTransition?.skipTransition();
    });
  </script>
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; margin-top: -56px; padding-top: 56px; }
  /* A tilted strip of the picks' posters, darkened and faded out, behind the tagline. */
  .collage {
    position: absolute; z-index: -1; top: 0; left: 50%; display: flex; gap: var(--space-3);
    translate: -50% 0; rotate: -8deg;
    filter: blur(1.5px) saturate(1.1) brightness(0.5); opacity: 0.55;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 95%);
  }
  .collage img { width: 160px; height: auto; flex: none; aspect-ratio: 2 / 3; object-fit: cover; border-radius: var(--radius-media); }
  .collage img:nth-child(even) { translate: 0 48px; }
  @media (min-width: 720px) { .collage img { width: 180px; } }
  /* Forced colours (Windows High Contrast) recolour text but not images, so the posters would sit behind it. */
  @media (forced-colors: active) { .collage { display: none; } }
  .hero-in { padding-top: var(--space-8); padding-bottom: var(--space-6); }
  .eyebrow { margin-bottom: var(--space-2); }
  h1 { max-width: 15ch; font-size: var(--text-xl); line-height: 1.02; }
  h1 span { color: var(--accent); }
  .promise { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--space-4) 0 0; padding: 0; list-style: none; }
  .promise :global(.icon) { color: var(--accent); }

  .finder {
    position: sticky; top: 0; z-index: 2; padding: var(--space-3) 0 var(--space-2);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px);
  }
  .finder[hidden] { display: none; }
  .finder-in { display: grid; gap: var(--space-2) var(--space-4); }
  @media (min-width: 720px) { .finder-in { grid-template-columns: minmax(0, 1fr) auto; align-items: center; } }
  .search { position: relative; display: flex; align-items: center; }
  .search :global(.icon) { position: absolute; left: var(--space-3); color: var(--muted); pointer-events: none; }
  .search input {
    width: 100%; min-height: 44px; padding: 0 var(--space-3) 0 40px;
    border: 1px solid var(--line); border-radius: var(--radius-media); background: var(--surface); color: var(--text);
    /* 16px at least: iOS zooms into a smaller field when it's focused. */
    font: max(16px, var(--text-md)) var(--font-body);
  }
  .search input::placeholder { color: var(--muted); }
  .search input:hover { border-color: color-mix(in srgb, var(--text) 30%, transparent); }
  .search input:focus { border-color: var(--accent); outline-offset: 2px; }
  /* The chips in one row, scrolling sideways on the narrowest phones rather than wrapping. */
  .time {
    display: flex; align-items: center; gap: var(--space-2); overflow-x: auto; scrollbar-width: none;
    margin: 0 calc(-1 * var(--gutter)); padding: 4px var(--gutter);
  }
  .time::-webkit-scrollbar { display: none; }
  .time > * { flex: none; }
  @media (min-width: 720px) { .time { margin: 0; padding: 4px; } }
  .note { grid-column: 1 / -1; display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--space-2); min-height: 24px; margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .note .f-clear { display: none; }
  .finder:has(#time input:checked) .note .f-clear { display: inline-flex; align-items: center; }

  .results { list-style: none; padding-top: var(--space-4); padding-bottom: var(--space-8); min-height: 100dvh; }
  .results:empty { display: none; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: var(--space-4) var(--space-3); margin: 0 auto; list-style: none; }
  @media (min-width: 720px) { .tiles { grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: var(--space-6) var(--space-4); } }
  .tiles > :global(li) { display: flex; min-width: 0; }
  .tiles :global(.tile) { width: 100%; }

  /* A time row shows while its hour limit is chosen. */
  .fit { display: none; padding-top: var(--space-6); }
  #home:has(#f-h20:checked) .fit[data-h="20"],
  #home:has(#f-h40:checked) .fit[data-h="40"],
  #home:has(#f-h80:checked) .fit[data-h="80"] { display: block; }
  .fit h2 { display: flex; align-items: center; gap: var(--space-2); }
  .fit h2, .wall-head h2 { font-size: var(--text-lg); }
  .fit h2 :global(.icon) { color: var(--accent); }
  .track {
    display: flex; gap: var(--space-3); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; list-style: none; margin: 0;
    /* 10px on top leaves room for the focused tile's ring, which the scroller would otherwise clip. */
    padding: 10px max(var(--gutter), calc((100% - 1100px) / 2 + var(--gutter))) var(--space-2);
    scroll-padding-inline: max(var(--gutter), calc((100% - 1100px) / 2 + var(--gutter)));
  }
  .track::-webkit-scrollbar { display: none; }
  .track li { flex: none; display: flex; width: 112px; scroll-snap-align: start; }
  @media (min-width: 720px) { .track li { width: 140px; } }

  .wall { padding-top: var(--space-6); }
  .wall-head { margin-bottom: var(--space-4); }
  .wall-head p { margin: var(--space-1) 0 0; font-size: var(--text-sm); }
  /* "Or tap one you loved" under a time row, "Tap one you loved" on its own. */
  .w-or, #home:has([name="hours"]:checked) .w-tap { display: none; }
  #home:has([name="hours"]:checked) .w-or { display: inline; }
  /* While the search has results, they take the place of the rows and the wall. */
  #home.typing :is(.fit, .wall) { display: none; }
</style>
