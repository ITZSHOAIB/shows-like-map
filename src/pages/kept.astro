---
// The shows you've kept (#4), or a list someone shared with you (/kept/?s=…). Built in the browser from this browser's
// storage and the search index, so status and hours are always this week's. Nothing in it for search engines.
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { STATUS_LABEL } from "../lib/catalogue";
---

<Base title="Kept | Shows Like Map" description="The shows you've kept to watch, in this browser." path="/kept/" noindex>
  <main class="wrap kept" id="kept" data-labels={JSON.stringify(STATUS_LABEL)}>
    <p class="eyebrow" id="k-eyebrow">Your list</p>
    <h1 id="k-title" tabindex="-1">Kept to watch</h1>
    <p class="muted" id="k-note" role="status">Loading your list…</p>
    <div class="k-acts" id="k-acts" hidden>
      <button class="pill k-btn" id="k-share" type="button"><Icon name="share-network" /> Share this list</button>
      <button class="pill k-btn k-main" id="k-all" type="button" hidden><Icon name="bookmark-simple" /> <span>Keep all</span></button>
      <a class="pill k-btn" id="k-mine" href="/kept/" hidden>Your own list</a>
    </div>
    <ul class="k-tiles" id="k-tiles" role="list" aria-labelledby="k-title"></ul>
    <p class="k-empty" id="k-empty" hidden>
      <span>Nothing kept yet. On any show, tap <b>Keep</b> to save it here for later.</span>
      <a class="pill k-btn" href="/"><Icon name="magnifying-glass" /> Find a show</a>
    </p>
    <noscript><p class="muted">Your list lives in this browser and needs JavaScript to show.</p></noscript>
  </main>
</Base>

<script>
  import { fromShare, merged, readKept, shareUrl, toggled, writeKept } from "../lib/kept";
  import type { Entry } from "../lib/search";
  import { tileOf } from "../lib/tile";

  const root = document.getElementById("kept")!;
  const labels: Record<string, string> = JSON.parse(root.dataset.labels!);
  const $ = (id: string) => document.getElementById(id)!;
  const note = $("k-note"), tiles = $("k-tiles"), acts = $("k-acts"), empty = $("k-empty"), title = $("k-title");
  const share = $("k-share") as HTMLButtonElement, all = $("k-all") as HTMLButtonElement, mine = $("k-mine");

  let bySlug = new Map<string, Entry>();
  let rank = new Map<string, number>(); // each show's place in the index: a name for its tile's slide (view transitions)
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  /** A change to the list, with the tiles sliding to their new places where the browser can. */
  const slide = (change: () => void) =>
    document.startViewTransition && !still.matches ? document.startViewTransition(change).updateCallbackDone : (change(), Promise.resolve());
  let shared = fromShare(location.search); // null: your own list

  const plural = (n: number) => `${n} ${n === 1 ? "show" : "shows"}`;
  const nameOf = (slug: string) => bySlug.get(slug)![1];

  function render() {
    const own = shared === null;
    const kept = readKept();
    const slugs = (shared ?? kept).filter((s) => bySlug.has(s)); // a show gone from the catalogue drops out
    const missing = own ? [] : slugs.filter((s) => !kept.includes(s));
    $("k-eyebrow").textContent = own ? "Your list" : "Shared with you";
    title.textContent = own ? "Kept to watch" : "A list of shows to watch";
    empty.hidden = !own || slugs.length > 0;
    acts.hidden = slugs.length === 0 && (own || kept.length === 0);
    share.hidden = !own;
    mine.hidden = own || kept.length === 0;
    all.hidden = own || missing.length === 0;
    all.querySelector("span")!.textContent = slugs.length === missing.length ? `Keep all ${slugs.length}` : `Keep the ${missing.length} you haven't`;
    if (own) note.textContent = slugs.length ? `${plural(slugs.length)}, newest first. Kept in this browser only.` : "";
    else if (!slugs.length) note.textContent = "This link has no shows in it that we know.";
    else note.textContent = missing.length ? plural(slugs.length) : `${plural(slugs.length)}. You've kept them all.`;
    tiles.replaceChildren(...slugs.map((slug) => item(slug, own)));
  }

  function item(slug: string, own: boolean) {
    const li = document.createElement("li");
    li.dataset.slug = slug;
    li.style.viewTransitionName = `k${rank.get(slug)}`;
    li.append(tileOf(bySlug.get(slug)!, labels));
    if (!own) return li;
    const drop = Object.assign(document.createElement("button"), { type: "button", className: "k-drop", textContent: "Remove" });
    drop.setAttribute("aria-label", `Remove ${nameOf(slug)}`);
    drop.addEventListener("click", () => {
      const next = ((li.nextElementSibling ?? li.previousElementSibling) as HTMLElement | null)?.dataset.slug;
      writeKept(toggled(readKept(), slug));
      dispatchEvent(new Event("slm:kept"));
      slide(render).then(() => {
        note.textContent = `Removed ${nameOf(slug)}. ${note.textContent}`.trim();
        // Focus stays in the list: on the Remove of the show that took its place, else on the heading.
        const at = next && tiles.querySelector<HTMLElement>(`li[data-slug="${CSS.escape(next)}"] .k-drop`);
        (at || title).focus();
      });
    });
    li.append(drop);
    return li;
  }

  all.addEventListener("click", () => {
    writeKept(merged(readKept(), (shared ?? []).filter((s) => bySlug.has(s))));
    dispatchEvent(new Event("slm:kept"));
    shared = null;
    history.replaceState(null, "", "/kept/");
    render();
    note.textContent = `Kept. ${note.textContent}`;
    title.focus();
  });

  share.addEventListener("click", async () => {
    const url = shareUrl(location.origin, readKept().filter((s) => bySlug.has(s)));
    try {
      if (navigator.share) await navigator.share({ title: "Shows to watch", url });
      else {
        await navigator.clipboard.writeText(url);
        note.textContent = "Link copied. Anyone with it sees these shows.";
      }
    } catch (err) {
      if ((err as Error).name !== "AbortError") prompt("Copy this link:", url);
    }
  });

  addEventListener("storage", (e) => e.key === "slm:kept" && bySlug.size && render());
  addEventListener("pageshow", (e) => e.persisted && bySlug.size && render());

  fetch("/search.json")
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((entries: Entry[]) => {
      bySlug = new Map(entries.map((e) => [e[0], e]));
      rank = new Map(entries.map((e, i) => [e[0], i]));
      render();
    })
    .catch(() => (note.textContent = "Your list didn't load. Check your connection and reload."));
</script>

<style>
  .kept { padding-top: var(--space-6); padding-bottom: var(--space-4); }
  h1 { font-size: var(--text-xl); line-height: 1.02; margin: var(--space-1) 0 var(--space-2); }
  h1:focus { outline: none; }
  #k-note { margin: 0 0 var(--space-4); min-height: 1.4em; }
  .k-acts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); }
  .k-acts[hidden], .k-empty[hidden] { display: none; }
  .k-btn { min-height: 40px; padding: 0 var(--space-4); gap: var(--space-2); cursor: pointer; }
  .k-btn:hover { border-color: var(--accent); }
  .k-btn :global(.icon) { color: var(--accent); }
  .k-main { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .k-main :global(.icon) { color: var(--bg); }
  /* Three across on every phone, like the home page's grid (auto-fill gave a 360px phone two huge posters). */
  .k-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6) var(--space-3); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 560px) { .k-tiles { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); } }
  @media (min-width: 720px) { .k-tiles { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--space-8) var(--space-4); } }
  .k-tiles :global(li) { display: grid; gap: var(--space-1); align-content: start; min-width: 0; }
  .k-tiles :global(.k-drop) {
    justify-self: start; min-height: 24px; padding: 2px 0; border: 0; background: none; color: var(--muted); font: inherit; font-size: var(--text-xs);
    text-decoration: underline; text-underline-offset: 2px; cursor: pointer;
  }
  .k-tiles :global(.k-drop:hover) { color: var(--text); }
  .k-tiles :global(.k-drop:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .k-empty { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--muted); max-width: 52ch; }
  @media (forced-colors: active) {
    .k-main { forced-color-adjust: none; background: ButtonText; color: ButtonFace; border-color: ButtonText; }
    .k-main :global(.icon) { color: ButtonFace; }
  }
</style>
